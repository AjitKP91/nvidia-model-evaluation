{"id": "nat_ar_28", "language": "ar", "text": "\u0641\u0643\u0631 \u0641\u064a \u0645\u0633\u0627\u0631 \u0627\u0644\u062a\u0632\u0644\u062c \u0639\u0644\u0649 \u0627\u0644\u062c\u0644\u064a\u062f \u0628\u0627\u0639\u062a\u0628\u0627\u0631\u0647 \u0645\u0633\u0627\u0631\u064b\u0627 \u0645\u0645\u0627\u062b\u0644 \u0644\u0644\u0645\u0634\u064a \u0644\u0645\u0633\u0627\u0641\u0627\u062a \u0637\u0648\u064a\u0644\u0629.", "audio_duration_s": 5.201269841269841, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 2.9984672738928007, "dnsmos_sig": 3.562520642666072, "dnsmos_bak": 3.5896913546622136}
