{"id": "prosody_ar_7", "language": "ar", "text": "\u0648\u0645\u0646\u0630 \u0639\u0627\u0645 1988\u060c \u062a\u0648\u062c\u0651\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u0627\u0642\u062a\u0631\u0627\u0639 \u0634\u0641\u0627\u0641\u0629 \u0628\u062d\u064a\u062b \u064a\u0645\u0643\u0646 \u0644\u0644\u0646\u0627\u062e\u0628\u064a\u0646 \u0648\u0627\u0644\u0645\u0631\u0627\u0642\u0628\u064a\u0646 \u0623\u0646 \u064a\u062a\u0623\u0643\u062f\u0648\u0627 \u0645\u0646 \u0639\u062f\u0645 \u0648\u062c\u0648\u062f \u0645\u063a\u0644\u0641\u0627\u062a \u0641\u064a \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u062a\u0635\u0648\u064a\u062a\u060c \u0648\u0623\u0646\u0647 \u0644\u0627 \u064a\u062a\u0645 \u0625\u0636\u0627\u0641\u0629 \u0645\u063a\u0644\u0641\u0627\u062a \u0625\u0644\u0627 \u0645\u063a\u0644\u0641\u0627\u062a \u0627\u0644\u0646\u0627\u062e\u0628\u064a\u0646 \u0627\u0644\u0645\u0633\u062c\u0644\u064a\u0646 \u0648\u0627\u0644\u0645\u0635\u0631\u0651\u062d \u0644\u0647\u0645 \u062d\u0633\u0628 \u0627\u0644\u0623\u0635\u0648\u0644 \u0648\u0627\u0644\u0645\u0641\u0648\u0636\u064a\u0646.", "wpm": 152.0, "f0_mean_hz": 187.1, "f0_std_intra_hz": 31.0, "f0_range_intra_hz": 80.2, "npvi": 78.5, "pause_ratio": 0.007}
