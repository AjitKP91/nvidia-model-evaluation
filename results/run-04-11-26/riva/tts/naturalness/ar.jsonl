{"id": "nat_ar_0", "language": "ar", "text": "\u062a\u0634\u0643\u0644\u062a \u0641\u064a \u0627\u0644\u0645\u062d\u064a\u0637 \u0627\u0644\u0623\u0637\u0644\u0633\u064a \u0627\u0644\u064a\u0648\u0645 \u0639\u0627\u0634\u0631 \u0639\u0627\u0635\u0641\u0629 \u0645\u064f\u0633\u0645\u0627\u0629 \u0644\u0645\u0648\u0633\u0645 \u0627\u0644\u0623\u0639\u0627\u0635\u064a\u0631 \u0627\u0644\u0623\u0637\u0644\u0633\u064a\u0629\u060c \u0627\u0644\u0639\u0627\u0635\u0641\u0629 \u0634\u0628\u0647 \u0627\u0644\u0627\u0633\u062a\u0648\u0627\u0626\u064a\u0629 \u062c\u064a\u0631\u064a.", "audio_duration_s": 6.965986394557823, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.453565947602203, "dnsmos_sig": 3.680500355465264, "dnsmos_bak": 4.160198342983659}
{"id": "nat_ar_1", "language": "ar", "text": "\u062a\u063a\u0627\u062f\u0631 \u0627\u0644\u062d\u0627\u0641\u0644\u0627\u062a \u0627\u0644\u0645\u062d\u0637\u0629 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629 \u0628\u064a\u0646 \u0627\u0644\u0645\u0646\u0627\u0637\u0642 (\u0639\u0628\u0631 \u0627\u0644\u0646\u0647\u0631) \u0641\u064a \u062e\u0644\u0627\u0644 \u0627\u0644\u064a\u0648\u0645 \u0639\u0644\u0649 \u0627\u0644\u0631\u063a\u0645 \u0645\u0646 \u0623\u0646 \u0645\u0639\u0638\u0645\u0647\u0627 \u0648\u062e\u0627\u0635\u0629 \u0627\u0644\u0645\u062a\u062c\u0647\u0629 \u0645\u0646\u0647\u0627 \u0625\u0644\u0649 \u0627\u0644\u0634\u0631\u0642 \u0648\u062c\u0627\u0643\u0627\u0631/\u0628\u0648\u0645\u062b\u0627\u0646\u062c \u062a\u063a\u0627\u062f\u0631 \u0628\u064a\u0646 06:30 \u0648 07:30.", "audio_duration_s": 10.681179138321996, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.5642265410475167, "dnsmos_sig": 3.770315797259682, "dnsmos_bak": 4.226535801289891}
{"id": "nat_ar_2", "language": "ar", "text": "\u064a\u062a\u0645\u0651\u064f \u062f\u0639\u0652\u0645 \u0627\u0644\u062a\u0639\u0644\u0651\u064f\u0645 \u0627\u0644\u062a\u0641\u0627\u0639\u0644\u064a\u0651 \u0641\u064a \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u062f\u0627\u062e\u0644\u064a\u064b\u0627 \u0648\u064a\u0647\u062f\u0641 \u0625\u0644\u0649 \u0637\u0631\u062d \u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0648\u0627\u0644\u062a\u062d\u0641\u064a\u0632 \u0648\u0634\u0631\u062d \u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a\u0650 \u0627\u0644\u062a\u064a \u0642\u062f \u064a\u0643\u0648\u0646 \u0645\u0646 \u0627\u0644\u0635\u0639\u0628 \u0639\u0644\u0649 \u0627\u0644\u0637\u0627\u0644\u0628 \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639\u0647\u0627 \u0628\u0645\u0641\u0631\u062f\u0647.", "audio_duration_s": 9.659501133786849, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3268656026340655, "dnsmos_sig": 3.705435461144755, "dnsmos_bak": 3.9874153889429094}
{"id": "nat_ar_3", "language": "ar", "text": "\u0646\u0635\u0646\u0639 \u0628\u064a\u0648\u062a\u0646\u0627 \u0648\u0645\u0644\u0627\u0628\u0633\u0646\u0627 \u0645\u0646 \u0627\u0644\u0646\u0628\u0627\u062a\u0627\u062a . \u0645\u0639\u0638\u0645 \u0627\u0644\u0637\u0639\u0627\u0645 \u0627\u0644\u0630\u064a \u0646\u062a\u0646\u0627\u0648\u0644\u0647 \u0645\u0646 \u0627\u0644\u0646\u0628\u0627\u062a\u0627\u062a \u0643\u0630\u0644\u0643. \u0628\u062f\u0648\u0646 \u0627\u0644\u0646\u0628\u0627\u062a\u0627\u062a\u060c \u0644\u0627 \u064a\u0645\u0643\u0646 \u0644\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0628\u0642\u0627\u0621.", "audio_duration_s": 8.17342403628118, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.395933447272666, "dnsmos_sig": 3.7263296796487007, "dnsmos_bak": 4.084939050281157}
{"id": "nat_ar_4", "language": "ar", "text": "\u0625\u0646 \u0639\u0631\u0636 \u0627\u0644\u0635\u0648\u062a \u0648\u0627\u0644\u0636\u0648\u0621 \u0627\u0644\u0647\u0631\u0645\u064a \u0648\u0627\u062d\u062f \u0645\u0646 \u0623\u0645\u062a\u0639 \u0627\u0644\u0623\u0634\u064a\u0627\u0621 \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0628\u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0644\u0644\u0623\u0637\u0641\u0627\u0644.", "audio_duration_s": 5.015510204081632, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.0439211885677504, "dnsmos_sig": 3.6631992392252033, "dnsmos_bak": 3.610083532360931}
{"id": "nat_ar_5", "language": "ar", "text": "\u062a\u0630\u0643\u0631 \u0623\u0646\u0647 \u0639\u0644\u0649 \u0627\u0644\u0631\u063a\u0645 \u0645\u0646 \u0623\u0646 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u0641\u064a \u0627\u0644\u0645\u0646\u0635\u0627\u062a \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0642\u062f \u062a\u0643\u0648\u0646 \u0627\u0646\u062a\u0647\u062a\u060c \u0625\u0644\u0627 \u0623\u0646 \u0647\u0646\u0627\u0643 \u0623\u0642\u0633\u0627\u0645 \u0645\u0646 \u0627\u0644\u0645\u0647\u0631\u062c\u0627\u0646 \u0642\u062f \u062a\u0633\u062a\u0645\u0631 \u0641\u064a \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649 \u062d\u062a\u0649 \u0648\u0642\u062a \u0645\u062a\u0623\u062e\u0631 \u0645\u0646 \u0627\u0644\u0644\u064a\u0644.", "audio_duration_s": 10.309659863945578, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.6153245968011927, "dnsmos_sig": 3.8231142580206856, "dnsmos_bak": 4.212648039413378}
{"id": "nat_ar_6", "language": "ar", "text": "\u0623\u062f\u0649 \u0636\u0627\u0631\u0628\u0627 \u0627\u0644\u0643\u0631\u0629 \u0627\u0644\u0645\u062a\u0645\u0631\u0643\u0632\u064a\u0646 \u0641\u064a \u0627\u0644\u0648\u0633\u0637\u060c \u0633\u0627\u0634\u064a\u0646 \u062a\u064a\u0646\u062f\u0648\u0644\u0643\u0627\u0631 \u0648\u0631\u0627\u0647\u0648\u0644 \u062f\u0631\u0627\u0641\u064a\u062f\u060c \u062c\u064a\u062f\u064b\u0627 \u0648\u0623\u0642\u0627\u0645\u0627 \u0634\u0631\u0627\u0643\u0629 \u0623\u0643\u0633\u0628\u062a \u0644\u0644\u0641\u0631\u064a\u0642 \u0645\u0627\u0626\u0629 \u0646\u0642\u0637\u0629.", "audio_duration_s": 7.987664399092971, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3686234793367897, "dnsmos_sig": 3.6806529416430784, "dnsmos_bak": 4.069613145500284}
{"id": "nat_ar_7", "language": "ar", "text": "\u0648\u0645\u0646\u0630 \u0639\u0627\u0645 1988\u060c \u062a\u0648\u062c\u0651\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0635\u0646\u0627\u062f\u064a\u0642 \u0627\u0644\u0627\u0642\u062a\u0631\u0627\u0639 \u0634\u0641\u0627\u0641\u0629 \u0628\u062d\u064a\u062b \u064a\u0645\u0643\u0646 \u0644\u0644\u0646\u0627\u062e\u0628\u064a\u0646 \u0648\u0627\u0644\u0645\u0631\u0627\u0642\u0628\u064a\u0646 \u0623\u0646 \u064a\u062a\u0623\u0643\u062f\u0648\u0627 \u0645\u0646 \u0639\u062f\u0645 \u0648\u062c\u0648\u062f \u0645\u063a\u0644\u0641\u0627\u062a \u0641\u064a \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u062a\u0635\u0648\u064a\u062a\u060c \u0648\u0623\u0646\u0647 \u0644\u0627 \u064a\u062a\u0645 \u0625\u0636\u0627\u0641\u0629 \u0645\u063a\u0644\u0641\u0627\u062a \u0625\u0644\u0627 \u0645\u063a\u0644\u0641\u0627\u062a \u0627\u0644\u0646\u0627\u062e\u0628\u064a\u0646 \u0627\u0644\u0645\u0633\u062c\u0644\u064a\u0646 \u0648\u0627\u0644\u0645\u0635\u0631\u0651\u062d \u0644\u0647\u0645 \u062d\u0633\u0628 \u0627\u0644\u0623\u0635\u0648\u0644 \u0648\u0627\u0644\u0645\u0641\u0648\u0636\u064a\u0646.", "audio_duration_s": 14.675011337868481, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.373556779432699, "dnsmos_sig": 3.6995439255428506, "dnsmos_bak": 4.040023550400049}
{"id": "nat_ar_8", "language": "ar", "text": "\u0642\u0628\u0644 \u0648\u0635\u0648\u0644 \u0627\u0644\u0642\u0648\u0627\u062a\u060c \u0644\u0645 \u062a\u0648\u0627\u062c\u0647 \u0647\u0627\u064a\u062a\u064a \u0645\u0634\u0627\u0643\u0644 \u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0627\u0644\u0645\u0631\u0636 \u0645\u0646\u0630 \u0627\u0644\u0642\u0631\u0646 \u0627\u0644\u062a\u0627\u0633\u0639 \u0639\u0634\u0631.", "audio_duration_s": 5.294149659863946, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4952253610743567, "dnsmos_sig": 3.7258684736182106, "dnsmos_bak": 4.184938296989123}
{"id": "nat_ar_9", "language": "ar", "text": "\u0628\u0635\u0641\u062a\u0647 \u0631\u064a\u0627\u0636\u064a\u0651\u0627\u064b \u0634\u0627\u0645\u0644\u0627\u064b\u060c \u064a\u0645\u0643\u0646 \u0644\u0644\u0646\u0651\u0645\u0631 \u0627\u0644\u062a\u0651\u0633\u0644\u0642 (\u0648\u0625\u0646 \u0644\u0645 \u064a\u0643\u0646 \u0630\u0644\u0643 \u0628\u0634\u0643\u0644\u064d \u062c\u064a\u062f) \u0648\u0627\u0644\u0633\u0651\u0628\u0627\u062d\u0629 \u0648\u0627\u0644\u0642\u0641\u0632 \u0644\u0645\u0633\u0627\u0641\u0627\u062a\u064d \u0637\u0648\u064a\u0644\u0629\u064d \u0648\u0627\u0644\u0633\u0651\u062d\u0628 \u0628\u0642\u0648\u0651\u0629 \u062e\u0645\u0633\u0629 \u0623\u0636\u0639\u0627\u0641 \u0642\u0648\u0651\u0629 \u0627\u0644\u0625\u0646\u0633\u0627\u0646.", "audio_duration_s": 10.031020408163265, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.424561923813495, "dnsmos_sig": 3.6933993593745984, "dnsmos_bak": 4.1057616342243985}
{"id": "nat_ar_10", "language": "ar", "text": "\u0641\u064a \u062d\u0627\u0644 \u0643\u0646\u062a \u062a\u0639\u0628\u0631 \u0645\u0646\u0637\u0642\u0629 \u0628\u062d\u0631 \u0627\u0644\u0628\u0644\u0637\u064a\u0642 \u0627\u0644\u0634\u0645\u0627\u0644\u064a\u0629 \u0641\u064a \u0627\u0644\u0634\u062a\u0627\u0621\u060c \u0641\u064a\u062c\u0628 \u0623\u0646 \u062a\u0641\u062d\u0635 \u0645\u0648\u0642\u0639 \u0627\u0644\u0643\u0627\u0628\u064a\u0646\u0629\u060c \u0625\u0630 \u0623\u0646 \u0627\u0644\u0645\u0631\u0648\u0631 \u0639\u0628\u0631 \u0627\u0644\u062c\u0644\u064a\u062f \u064a\u0633\u0628\u0628 \u0636\u0648\u0636\u0627\u0621 \u0635\u0627\u062e\u0628\u0629 \u0644\u0644\u063a\u0627\u064a\u0629 \u0644\u0644\u0623\u0634\u062e\u0627\u0635 \u0627\u0644\u0623\u0643\u062b\u0631 \u062a\u0636\u0631\u0631\u0627\u064b.", "audio_duration_s": 10.495419501133787, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.48631511878749, "dnsmos_sig": 3.722312889395749, "dnsmos_bak": 4.1544274339783085}
{"id": "nat_ar_11", "language": "ar", "text": "\u0623\u064f\u0631\u0633\u0644 \u0627\u0644\u0642\u0645\u0631 \u0627\u0644\u0635\u0646\u0627\u0639\u064a \u0625\u0644\u0649 \u0627\u0644\u0641\u0636\u0627\u0621 \u0628\u0648\u0627\u0633\u0637\u0629 \u0635\u0627\u0631\u0648\u062e. \u064a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0639\u0644\u0645\u0627\u0621 \u0627\u0644\u062a\u0644\u0633\u0643\u0648\u0628\u0627\u062a \u0641\u064a \u0627\u0644\u0641\u0636\u0627\u0621 \u0644\u0623\u0646 \u0627\u0644\u063a\u0644\u0627\u0641 \u0627\u0644\u062c\u0648\u064a \u0644\u0643\u0648\u0643\u0628 \u0627\u0644\u0623\u0631\u0636 \u064a\u0634\u0648\u0647 \u0628\u0639\u0636 \u0627\u0644\u0636\u0648\u0621 \u0648\u0627\u0644\u0631\u0624\u064a\u0629.", "audio_duration_s": 8.823582766439909, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4975011127228868, "dnsmos_sig": 3.749689396140129, "dnsmos_bak": 4.156737906410226}
{"id": "nat_ar_12", "language": "ar", "text": "\u0628\u0635\u0641\u0629 \u0639\u0627\u0645\u0629\u060c \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0638\u0647\u0631 \u0633\u0644\u0648\u0643\u0627\u0646 \u0639\u0646\u062f\u0645\u0627 \u064a\u0628\u062f\u0623 \u0627\u0644\u0645\u062f\u064a\u0631\u0648\u0646 \u0641\u064a \u0642\u064a\u0627\u062f\u0629 \u0623\u0642\u0631\u0627\u0646\u0647\u0645 \u0627\u0644\u0633\u0627\u0628\u0642\u064a\u0646 \u0623\u062d\u062f\u0647\u0645\u0627 \u0647\u0648 \u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u0628\u0642\u0627\u0621 \"\u0645\u062b\u0644 \u0627\u0644\u0622\u062e\u0631\u064a\u0646\" (\u0623\u0648 \u0627\u0644\u0623\u062e\u0631\u064a\u0627\u062a).", "audio_duration_s": 8.916462585034013, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.1669796493574034, "dnsmos_sig": 3.620953915019982, "dnsmos_bak": 3.849728876166622}
{"id": "nat_ar_13", "language": "ar", "text": "\u064a\u062a\u0635\u0627\u0639\u062f \u0645\u0646 \u0627\u0644\u0645\u0635\u0646\u0639 \u062f\u062e\u0627\u0646\u0627\u064b \u0623\u0628\u064a\u0636\u060c \u0648\u0647\u0630\u0627 \u0645\u0627 \u0623\u0638\u0647\u0631\u062a\u0647 \u062a\u0642\u0627\u0631\u064a\u0631 \u062a\u0644\u0641\u0632\u064a\u0648\u0646\u064a\u0629.", "audio_duration_s": 4.551111111111111, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.385384814941354, "dnsmos_sig": 3.7064148048907684, "dnsmos_bak": 4.079449619624938}
{"id": "nat_ar_14", "language": "ar", "text": "\u064a\u0645\u0643\u0646\u0643 \u0623\u0646 \u062a\u0633\u0645\u0639 \u0635\u0648\u062a \u0627\u0644\u0633\u064a\u0651\u0627\u062d \u0648\u0627\u0644\u0628\u0627\u0626\u0639\u064a\u0646 \u0647\u0646\u0627 \u062f\u0627\u0626\u0645\u0627\u064b \u0639\u0627\u062f\u0629\u064b. \u0641\u0642\u0635\u0629 \u0627\u0644\u0635\u0648\u062a \u0648\u0627\u0644\u0636\u0648\u0621 \u062a\u0634\u0628\u0647 \u0642\u0635\u0629 \u0643\u062a\u0627\u0628\u064d.", "audio_duration_s": 6.130068027210885, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.27231953631021, "dnsmos_sig": 3.626355544711224, "dnsmos_bak": 4.0099437460098715}
{"id": "nat_ar_15", "language": "ar", "text": "\u0644\u0643\u0646 \u0628\u0633\u0628\u0628 \u0645\u0648\u0642\u0639\u0647\u0627 \"\u0627\u0644\u0642\u0631\u064a\u0628 \u0645\u0646 \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0627\u0633\u062a\u0648\u0627\u0626\u064a\u0629\" \u0628\u0628\u0636\u0639 \u062f\u0631\u062c\u0627\u062a \u0641\u0642\u0637 \u0634\u0645\u0627\u0644 \u0627\u0644\u062e\u0637 \u0627\u0644\u0627\u0633\u062a\u0648\u0627\u0626\u064a\u060c \u0641\u0623\u0646\u062a\u0645 \u0628\u062d\u0627\u062c\u0629 \u0644\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0643\u0644\u0627\u0647\u0645\u0627: \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0627\u0644\u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u0645\u0631\u0629 \u0648\u0627\u0644\u0634\u0645\u0633 \u0627\u0644\u0644\u0627\u0641\u062d\u0629 (\u0648\u0630\u0644\u0643 \u0646\u0627\u062f\u0631\u0627\u064b \u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u0648\u0646 \u0627\u0644\u0633\u0645\u0627\u0621 \u0635\u0627\u0641\u064a\u0629).", "audio_duration_s": 13.653333333333334, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.458649718909598, "dnsmos_sig": 3.735432460301978, "dnsmos_bak": 4.072138093883069}
{"id": "nat_ar_16", "language": "ar", "text": "\u0627\u0641\u062a\u0631\u0636 \u0627\u0644\u0641\u064a\u0644\u0633\u0648\u0641 \u0623\u0631\u0633\u0637\u0648 \u0623\u0646 \u0643\u0644 \u0634\u064a\u0621 \u064a\u062a\u0643\u0648\u0646 \u0645\u0646 \u0645\u0632\u064a\u062c \u0645\u0646 \u0639\u0646\u0635\u0631 \u0623\u0648 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0623\u0631\u0628\u0639\u0629 \u0639\u0646\u0627\u0635\u0631 \u0647\u064a \u0627\u0644\u0623\u0631\u0636 \u0648\u0627\u0644\u0645\u0627\u0621 \u0648\u0627\u0644\u0647\u0648\u0627\u0621 \u0648\u0627\u0644\u0646\u0627\u0631.", "audio_duration_s": 8.17342403628118, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.306770607865352, "dnsmos_sig": 3.6077921168484877, "dnsmos_bak": 3.990132801963051}
{"id": "nat_ar_17", "language": "ar", "text": "\u0623\u062f\u0649 \u0645\u0627\u0631\u062a\u064a\u0644\u064a \u0623\u0645\u0633 \u0627\u0644\u0642\u0633\u0645 \u0641\u064a \u0645\u062c\u0644\u0633 \u0627\u0646\u062a\u062e\u0627\u0628\u064a \u0645\u0624\u0642\u062a \u062c\u062f\u064a\u062f \u0645\u0643\u0648\u0646 \u0645\u0646 \u062a\u0633\u0639\u0629 \u0623\u0639\u0636\u0627\u0621.", "audio_duration_s": 4.551111111111111, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.474071508873419, "dnsmos_sig": 3.7278269649619262, "dnsmos_bak": 4.156467016569331}
{"id": "nat_ar_18", "language": "ar", "text": "\u062c\u0631\u062a \u0627\u0644\u062a\u0642\u0627\u0644\u064a\u062f \u0639\u0644\u0649 \u0623\u0646 \u0648\u0638\u064a\u0641\u0629 \u0627\u0644\u0642\u0648\u0651\u0627\u062a \u0627\u0644\u0628\u062d\u0631\u064a\u0651\u0629 \u0647\u064a \u0636\u0645\u0627\u0646 \u0642\u062f\u0631\u0629 \u0628\u0644\u062f\u0643 \u0639\u0644\u0649 \u0646\u0642\u0644 \u0634\u0639\u0628\u0643 \u0648\u0628\u0636\u0627\u0626\u0639\u0647\u060c \u0628\u064a\u0646\u0645\u0627 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0646\u0641\u0633\u0647\u060c \u0627\u0639\u062a\u0631\u0627\u0636 \u0642\u062f\u0631\u0629 \u0639\u062f\u0648\u0651\u0643 \u0639\u0644\u0649 \u0646\u0642\u0644 \u0634\u0639\u0628\u0647 \u0648\u0628\u0636\u0627\u0626\u0639\u0647.", "audio_duration_s": 10.402539682539683, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.545277586821554, "dnsmos_sig": 3.7701515145970226, "dnsmos_bak": 4.210207775027858}
{"id": "nat_ar_19", "language": "ar", "text": "\u0644\u0627 \u062a\u0634\u0648\u0647 \u0627\u0644\u0645\u0648\u0642\u0639 \u0628\u0648\u0636\u0639 \u0639\u0644\u0627\u0645\u0627\u062a \u0623\u0648 \u0627\u0644\u0643\u062a\u0627\u0628\u0627\u062a \u0627\u0644\u062e\u0627\u062f\u0634\u0629 \u0639\u0644\u0649 \u0627\u0644\u062c\u062f\u0631\u0627\u0646 \u0641\u064a \u0627\u0644\u0645\u0628\u0627\u0646\u064a.", "audio_duration_s": 4.551111111111111, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.20265848827514, "dnsmos_sig": 3.65022413292335, "dnsmos_bak": 3.8379508923015964}
{"id": "nat_ar_20", "language": "ar", "text": "\u0627\u0644\u0633\u0628\u0627\u0626\u0643 \u0647\u064a \u0628\u0634\u0643\u0644 \u0623\u0633\u0627\u0633\u064a \u062e\u0644\u064a\u0637 \u0645\u0646 \u0627\u062b\u0646\u064a\u0646 \u0623\u0648 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u062f\u0646. \u0644\u0627 \u062a\u0646\u0633\u064e \u0623\u0646 \u0647\u0646\u0627\u0643 \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0641\u064a \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u062f\u0648\u0631\u064a.", "audio_duration_s": 7.244625850340136, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.1642736413323465, "dnsmos_sig": 3.599653284996927, "dnsmos_bak": 3.8695189912216015}
{"id": "nat_ar_21", "language": "ar", "text": "\u0633\u064e\u064a\u0633\u0652\u0645\u062d \u0630\u0644\u0643 \u0644\u0644\u0627\u0639\u0628\u064a\u0646 \u0628\u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0623\u0641\u0639\u0627\u0644 \u0648\u0627\u0644\u062d\u0631\u0643\u0627\u062a \u0641\u064a \u0623\u0644\u0639\u0627\u0628 \u0627\u0644\u0641\u064a\u062f\u064a\u0648 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u062a\u0644\u0648\u064a\u062d \u0628\u0627\u0644\u062c\u0647\u0627\u0632 \u0641\u064a \u0627\u0644\u0647\u0648\u0627\u0621.", "audio_duration_s": 6.222947845804988, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.378440576524351, "dnsmos_sig": 3.70998859653994, "dnsmos_bak": 4.030999285126812}
{"id": "nat_ar_22", "language": "ar", "text": "\u0646\u0635\u0646\u0639 \u0628\u064a\u0648\u062a\u0646\u0627 \u0648\u0645\u0644\u0627\u0628\u0633\u0646\u0627 \u0645\u0646 \u0627\u0644\u0646\u0628\u0627\u062a\u0627\u062a . \u0645\u0639\u0638\u0645 \u0627\u0644\u0637\u0639\u0627\u0645 \u0627\u0644\u0630\u064a \u0646\u062a\u0646\u0627\u0648\u0644\u0647 \u0645\u0646 \u0627\u0644\u0646\u0628\u0627\u062a\u0627\u062a \u0643\u0630\u0644\u0643. \u0628\u062f\u0648\u0646 \u0627\u0644\u0646\u0628\u0627\u062a\u0627\u062a\u060c \u0644\u0627 \u064a\u0645\u0643\u0646 \u0644\u0644\u062d\u064a\u0648\u0627\u0646\u0627\u062a \u0627\u0644\u0628\u0642\u0627\u0621.", "audio_duration_s": 8.17342403628118, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4286602372674224, "dnsmos_sig": 3.6813461077405454, "dnsmos_bak": 4.146087646131753}
{"id": "nat_ar_23", "language": "ar", "text": "\u0625\u0630\u0627 \u0623\u0631\u062f\u062a \u0623\u0646 \u062a\u0642\u062a\u0631\u0628 \u0645\u0646 \u0627\u0644\u0623\u062d\u062f\u0627\u062b\u060c \u0641\u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u0623\u0646 \u062a\u062f\u062e\u0644 \u0628\u0627\u0643\u0631\u0627\u064b \u0648\u0630\u0644\u0643 \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639 \u062a\u062e\u064a\u064a\u0645 \u0642\u0631\u064a\u0628 \u0645\u0646 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649.", "audio_duration_s": 6.594467120181406, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.421853861871805, "dnsmos_sig": 3.6957546940345543, "dnsmos_bak": 4.141385573411582}
{"id": "nat_ar_24", "language": "ar", "text": "\u0627\u0644\u0634\u0648\u0643\u0648\u0644\u0627\u062a\u0629 \u0627\u0644\u0633\u0627\u062e\u0646\u0629 \u0645\u062a\u0648\u0627\u0641\u0642\u0629 \u0645\u0639 \u0627\u0644\u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u0644\u0628\u0644\u062c\u064a\u0643\u064a\u0629. \u0639\u0635\u0627\u0626\u0631 \u0627\u0644\u0641\u0627\u0643\u0647\u0629 \u0645\u0645\u062a\u0627\u0632\u0629 \u0639\u0644\u0649 \u0627\u0644\u0631\u063a\u0645 \u0645\u0646 \u0623\u0646\u0647\u0627 \u0628\u0627\u0647\u0638\u0629 \u0627\u0644\u062b\u0645\u0646.", "audio_duration_s": 6.873106575963718, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4361679347128873, "dnsmos_sig": 3.7507345985143115, "dnsmos_bak": 4.057930911159174}
{"id": "nat_ar_25", "language": "ar", "text": "\u0644\u0644\u0623\u0633\u0641\u060c \u062f\u0631\u0627\u0633\u0629 \u062d\u0631\u0643\u0629 \u0627\u0644\u0633\u064a\u0631 \u0635\u0639\u0628\u0629 \u0644\u0623\u0646\u0647 \u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0648\u0642\u0639 \u0633\u0644\u0648\u0643 \u0627\u0644\u0633\u0627\u0626\u0642 \u0628\u064a\u0642\u064a\u0646 \u0645\u0627\u0626\u0629 \u0641\u064a \u0627\u0644\u0645\u0626\u0629.", "audio_duration_s": 6.222947845804988, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.56349916750872, "dnsmos_sig": 3.7442990226066413, "dnsmos_bak": 4.253738701991736}
{"id": "nat_ar_26", "language": "ar", "text": "\u0644\u0645 \u064a\u0635\u062f\u0631 \u062a\u062d\u0630\u064a\u0631 \u0639\u0646 \u062a\u0633\u0648\u0646\u0627\u0645\u064a\u060c \u0648\u0648\u0641\u0642\u0627 \u0644\u0648\u0643\u0627\u0644\u0629 \u062c\u0627\u0643\u0631\u062a\u0627 \u0644\u0644\u062c\u064a\u0648\u0641\u064a\u0632\u064a\u0627\u0621\u060c \u0644\u0646 \u064a\u0635\u062f\u0631 \u062a\u062d\u0630\u064a\u0631 \u0639\u0646 \u062a\u0633\u0648\u0646\u0627\u0645\u064a \u0644\u0623\u0646 \u0627\u0644\u0632\u0644\u0632\u0627\u0644 \u0644\u0645 \u064a\u0633\u062a\u0648\u0641 \u0645\u062a\u0637\u0644\u0628\u0627\u062a 6.5 \u062f\u0631\u062c\u0629.", "audio_duration_s": 9.287981859410431, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.5200106297534344, "dnsmos_sig": 3.796690788901865, "dnsmos_bak": 4.161742928496164}
