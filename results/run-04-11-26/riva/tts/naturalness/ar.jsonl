{"id": "nat_ar_44", "language": "ar", "text": "\u0644\u0627 \u064a\u0641\u0643\u0631 \u0627\u0644\u0639\u062f\u064a\u062f \u0641\u064a\u0647\u0627 \u0628\u0627\u0639\u062a\u0628\u0627\u0631\u0647\u0627 \u062f\u064a\u0646\u0627\u0635\u0648\u0631\u0627\u062a \u0644\u0623\u0646 \u0644\u062f\u064a\u0647\u0627 \u0631\u064a\u0634\u064b\u0627 \u0648\u064a\u0645\u0643\u0646\u0647\u0627 \u0627\u0644\u0637\u064a\u0631\u0627\u0646.", "audio_duration_s": 5.015510204081632, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3339877084504153, "dnsmos_sig": 3.703771054198476, "dnsmos_bak": 4.0042316402765366}
{"id": "nat_ar_45", "language": "ar", "text": "\u0625\u0646 \u0627\u0644\u0631\u064a\u0627\u062d \u0627\u0644\u0634\u062f\u064a\u062f\u0629 \u0648\u0627\u0644\u0628\u064e\u0631\u064e\u062f \u0648\u0627\u0644\u062a\u0647\u0637\u0627\u0644 \u0627\u0644\u0645\u0641\u0631\u0637 \u0648\u0627\u0644\u062d\u0631\u0627\u0626\u0642 \u0627\u0644\u0628\u0631\u064a\u0629 \u0647\u064a \u0623\u0634\u0643\u0627\u0644 \u0648\u0622\u062b\u0627\u0631 \u0627\u0644\u0637\u0642\u0633 \u0627\u0644\u0634\u062f\u064a\u062f\u060c \u0648\u0643\u0630\u0644\u0643 \u0627\u0644\u0639\u0648\u0627\u0635\u0641 \u0627\u0644\u0631\u0639\u062f\u064a\u0629 \u0648\u0627\u0644\u0623\u0639\u0627\u0635\u064a\u0631 \u0648\u0627\u0644\u0641\u064a\u0636\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0623\u0639\u0627\u0635\u064a\u0631 \u0627\u0644\u062d\u0644\u0632\u0648\u0646\u064a\u0629.", "audio_duration_s": 10.7740589569161, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4896241587530605, "dnsmos_sig": 3.719365077214452, "dnsmos_bak": 4.161505175040992}
{"id": "nat_ar_46", "language": "ar", "text": "\u0648\u0623\u062e\u064a\u0631\u0627\u064b\u060c \u064a\u0648\u062c\u062f \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0642\u0637\u0637 \u0627\u0644\u0635\u063a\u064a\u0631\u0629 (\u0628\u0645\u0627 \u0641\u064a\u0647\u0645 \u0627\u0644\u0642\u0637\u0637 \u0627\u0644\u0623\u0644\u064a\u0641\u0629 \u0627\u0644\u0633\u0627\u0626\u0628\u0629) \u062a\u0623\u0643\u0644 \u0627\u0644\u0641\u0631\u0627\u0626\u0633 \u0627\u0644\u0635\u063a\u064a\u0631\u0629 \u0627\u0644\u0623\u0643\u062b\u0631 \u0639\u062f\u062f\u0627\u064b \u0643\u0627\u0644\u062d\u0634\u0631\u0627\u062a \u0648\u0627\u0644\u0642\u0648\u0627\u0631\u0636 \u0648\u0627\u0644\u0633\u062d\u0627\u0644\u064a \u0648\u0627\u0644\u0637\u064a\u0648\u0631.", "audio_duration_s": 9.009342403628118, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.5514369632472915, "dnsmos_sig": 3.81455073744224, "dnsmos_bak": 4.156945696498488}
{"id": "nat_ar_47", "language": "ar", "text": "\u0644\u0642\u062f \u062c\u0639\u0644 \u062f\u0641\u0627\u0639 \u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0645\u0646\u0636\u0628\u0637 \u0648\u0645\u0647\u0627\u0631\u0627\u062a\u0647 \u0641\u064a \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0643\u0631\u0629 \u0648\u0639\u0645\u0644\u0647 \u0627\u0644\u062c\u0645\u0627\u0639\u064a\u0651\u064f \u0627\u0644\u0645\u0645\u062a\u0627\u0632\u060c \u0641\u0631\u064a\u0642 \u0645\u062a\u0645\u064a\u0632 \u0648\u0643\u0627\u0646 \u0645\u0646 \u0627\u0644\u0648\u0627\u0636\u062d \u0623\u0646 \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u0641\u0631\u064a\u0642 \u0627\u0644\u0630\u064a \u064a\u062c\u0628 \u0627\u0644\u062a\u063a\u0644\u0628 \u0639\u0644\u064a\u0647.", "audio_duration_s": 10.402539682539683, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4828615819986375, "dnsmos_sig": 3.7101551596663676, "dnsmos_bak": 4.182377881698658}
{"id": "nat_ar_48", "language": "ar", "text": "\u0639\u0646\u062f \u0627\u0633\u062a\u063a\u0644\u0627\u0644 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0628\u0634\u0643\u0644 \u0641\u0639\u0627\u0644 \u0639\u0628\u0631 \u0627\u0644\u0625\u062f\u0627\u0631\u0627\u062a \u0627\u0644\u0648\u0638\u064a\u0641\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u0646\u0638\u0645\u0629\u060c \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u062a\u062d\u0642\u0642 \u0627\u0644\u0625\u0628\u062f\u0627\u0639 \u0648\u0627\u0644\u0628\u0631\u0627\u0639\u0629.", "audio_duration_s": 7.430385487528345, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.338678628489423, "dnsmos_sig": 3.595463714349343, "dnsmos_bak": 4.0942486328046686}
{"id": "nat_ar_49", "language": "ar", "text": "\u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u0631\u0623\u0633\u064a\u0629 \u0627\u0644\u062e\u0627\u0644\u064a\u0629 \u062a\u062d\u062a \u0627\u0644\u062c\u0633\u0631 \u0661\u0665 \u0645\u062a\u0631\u0627\u064b. \u0627\u0643\u062a\u0645\u0644 \u0627\u0644\u0628\u0646\u0627\u0621 \u0641\u064a \u0622\u0628 \u0662\u0660\u0661\u0661\u060c \u0648\u0644\u0645 \u064a\u064f\u0641\u0652\u062a\u064e\u062d\u0652 \u0623\u0645\u0627\u0645 \u062d\u0631\u0643\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u062d\u062a\u0649 \u0622\u0630\u0627\u0631 \u0662\u0660\u0661\u0667.", "audio_duration_s": 6.965986394557823, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3187422723392683, "dnsmos_sig": 3.6316603735749613, "dnsmos_bak": 4.010202138262028}
