{"id": "prosody_hi_20", "language": "hi", "text": "\u091c\u093f\u0938 \u0938\u092e\u092f \u0918\u091f\u0928\u093e\u090f\u0901 \u0939\u0941\u0908 \u0909\u0938\u0915\u0947 \u092f\u0941\u0917 \u0915\u094b \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u092f\u0942\u0930\u094b\u092a \u0915\u0947 \u0907\u0924\u093f\u0939\u093e\u0938 \u092e\u0947\u0902 11\u0935\u0940\u0902, 12\u0935\u0940\u0902 \u0914\u0930 13\u0935\u0940\u0902 \u0938\u0926\u0940 (AD 1000-1300) \u092e\u0947\u0902 \u092f\u0942\u0930\u094b\u092a\u093f\u092f\u0928 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u0947 \u0909\u091a\u094d\u091a \u092e\u0927\u094d\u092f \u092f\u0941\u0917 \u0915\u0940 \u0905\u0935\u0927\u093f \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092c\u0924\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948.", "wpm": 163.8, "f0_mean_hz": 190.8, "f0_std_intra_hz": 26.9, "f0_range_intra_hz": 89.7, "npvi": 87.9, "pause_ratio": 0.005}
