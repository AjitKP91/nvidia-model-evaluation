{"id": "nat_ko_40", "language": "ko", "text": "\uc6d0\ub2e8\uc774 \ub108\ubb34 \ub728\uac70\uc6cc\uc9c0\uc9c0 \uc54a\ub3c4\ub85d \uc8fc\uc758\ud558\uc138\uc694(\uc6d0\ub2e8\uc774 \uc218\ucd95\ud558\uac70\ub098 \uadf8\uc744\ub9b4 \uc218 \uc788\uc2b5\ub2c8\ub2e4).", "audio_duration_s": 5.6656689342403626, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.263582610069196, "dnsmos_sig": 3.6362898464227342, "dnsmos_bak": 3.921010542366376}
{"id": "nat_ko_41", "language": "ko", "text": "\ub3c5\ub9bd \uc804\uc7c1 \uae30\uac04 \ub3d9\uc548 13\uac1c \uc8fc\ub294 \uc6b0\uc120 \uc5f0\ud569 \uaddc\uc57d\uc5d0 \ub530\ub77c \uc758\ud68c\uac00 \uc720\uc77c\ud55c \uad6c\uc131 \uc694\uc18c\uc778 \uad8c\ub825\uc774 \uac15\ud558\uc9c0 \uc54a\uc740 \uc911\uc559 \uc815\ubd80\ub97c \uad6c\uc131\ud588\ub2e4.", "audio_duration_s": 7.894784580498866, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3504728856793196, "dnsmos_sig": 3.675290332701756, "dnsmos_bak": 4.071532573180424}
{"id": "nat_ko_42", "language": "ko", "text": "\ub2e8\uc21c\ud558\uba74\uc11c\ub3c4 \ud2b9\ud788 \uc5ec\ub984\ucca0\uc5d0 \uc778\uae30 \uc788\ub294 \uc800\ub141\uc2dd\uc0ac\ub294 \uce58\uc988\ub098 \ucc38\uce58 \ub4f1\uacfc \uac19\uc740 \uc190\uc27d\uac8c \uad6c\ud560 \uc218 \uc788\ub294 \uc591\ub150\uacfc \ud1a0\ub9c8\ud1a0, \uc62c\ub9ac\ube0c\uc624\uc77c\uc744 \uacc1\ub4e4\uc778 \ube75\uc778 \ud30c \uc5e0\ube0c \uc62c\ub9ac\uc785\ub2c8\ub2e4.", "audio_duration_s": 11.609977324263038, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3881279169083647, "dnsmos_sig": 3.653635258097128, "dnsmos_bak": 4.130482894899583}
{"id": "nat_ko_43", "language": "ko", "text": "\uc0ac\uc790\ub294 \ubb34\ub9ac \uc9c0\uc5b4 \uc0ac\ub294 \uac00\uc7a5 \uc0ac\ud68c\uc801\uc778 \uace0\uc591\uc774\uacfc \ub3d9\ubb3c\uc785\ub2c8\ub2e4.", "audio_duration_s": 4.272471655328798, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.249539612288928, "dnsmos_sig": 3.5614911087551997, "dnsmos_bak": 3.997426527706524}
{"id": "nat_ko_44", "language": "ko", "text": "FAA\uc758 \uc8fc\uc7a5\uc5d0 \ub530\ub974\uba74 NextGen\uc740 \ud56d\uacf5\uae30\uac00 \ub354 \uc9e7\uc740 \ub178\uc120\uc744 \ube44\ud589\ud574\uc11c \ub9e4\ub144 \uc218\ubc31\ub9cc \uac24\ub7f0\uc758 \uc5f0\ub8cc\ub97c \uc808\uc57d\ud558\uace0 \ud0c4\uc18c \ubc30\ucd9c\uc744 \uc904\uc77c \uc218 \uc788\ub294 \uc2dc\uc2a4\ud15c\uc785\ub2c8\ub2e4.", "audio_duration_s": 9.752380952380953, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4667806247014674, "dnsmos_sig": 3.6959811524635797, "dnsmos_bak": 4.194729608282934}
{"id": "nat_ko_45", "language": "ko", "text": "\ub300\uae30\uc5c5\uc740 \uc77c\ubd80 \ud56d\ub85c\uc5d0\uc11c \uc790\uc0ac \uc18c\uc18d \ud56d\uacf5\uae30\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4\ub9cc \uadf8\ubc16\uc5d0 \ub2e4\ub978 \ud56d\ub85c\uc774\uac70\ub098 \uc18c\uae30\uc5c5\uc774\ub77c\uba74 \ubb38\uc81c\uac00 \uc788\uc2b5\ub2c8\ub2e4.", "audio_duration_s": 7.616145124716553, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.5389052933214256, "dnsmos_sig": 3.7503682132207405, "dnsmos_bak": 4.216403910645842}
{"id": "nat_ko_46", "language": "ko", "text": "\uc0ac\uce58\uc758 \uc9c4\uc6d0\uc9c0\ub77c\ub294 \uba85\uc131\uc740 \uc11c\uae30 400\ub144\uacbd\uc5d0 \uc2dc\uc791\ud558\uc5ec \uc11c\uae30 1100\ub144\uacbd\uae4c\uc9c0 \uc774\uc5b4\uc84c\uc2b5\ub2c8\ub2e4.", "audio_duration_s": 5.944308390022676, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.36069428989203, "dnsmos_sig": 3.6114579626314147, "dnsmos_bak": 4.083675161694591}
{"id": "nat_ko_47", "language": "ko", "text": "\uc0ac\ub78c\ub4e4\uc740 \ubb54\uac00 \uc0c8\ub85c\uc6b4 \uac83\uc774 \uc0dd\uae34\ub2e4\uba74, \ud0a4\ubcf4\ub4dc\uac00 \uc5b4\ub5bb\uac8c \ub420 \uac83\uc778\uc9c0 \uad81\uae08\ud574\ud558\uace0 \uc788\uc744 \ubfd0\uc774\ub2e4.", "audio_duration_s": 5.758548752834467, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4930713041762305, "dnsmos_sig": 3.7404391877706855, "dnsmos_bak": 4.148758633212266}
{"id": "nat_ko_48", "language": "ko", "text": "\uc544\uc9c1\ub3c4 \uc874\uc7ac\ud558\ub294 \uac83\uc73c\ub85c \uc54c\ub824\uc9c4 25\uac1c\uc758 \ub358\ub7a9 \ube0c\ub85c\ub4dc \uc0ac\uc774\ub4dc\ub294 \uc774 \ubb38\uc11c\uc758 \ub0a8\uc544\uc788\ub294 \uac00\uc7a5 \uc624\ub798\ub41c \uc0ac\ubcf8\uc774\ub2e4. \uc190\uc73c\ub85c \uc4f4 \uc6d0\ubcf8\uc740 \ub354 \uc774\uc0c1 \ub0a8\uc544 \uc788\uc9c0 \uc54a\ub2e4.", "audio_duration_s": 9.380861678004536, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3674171968369033, "dnsmos_sig": 3.5989367338521707, "dnsmos_bak": 4.1557087970314335}
