{"id": "nat_hi_0", "language": "hi", "text": "\u0915\u0941\u091b \u0905\u0923\u0941\u0913\u0902 \u092e\u0947\u0902 \u0905\u0938\u094d\u0925\u093f\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u0915 \u0939\u094b\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0915\u093e \u092e\u0924\u0932\u092c \u092f\u0939 \u0939\u0948 \u0915\u093f \u0909\u0928\u092e\u0947\u0902 \u0925\u094b\u0921\u093c\u0947 \u092f\u093e \u092c\u093f\u0928\u093e \u0915\u093f\u0938\u0940 \u091d\u091f\u0915\u0947 \u0938\u0947 \u091f\u0942\u091f\u0928\u0947 \u0915\u0940 \u092a\u094d\u0930\u0935\u0943\u0924\u094d\u0924\u093f \u0939\u094b\u0924\u0940 \u0939\u0948,", "audio_duration_s": 7.058866213151927, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.1727538805975657, "dnsmos_sig": 3.5322627739420454, "dnsmos_bak": 3.934958340492544}
{"id": "nat_hi_1", "language": "hi", "text": "\u0917\u094d\u0930\u0940\u0928\u0932\u0948\u0902\u0921 \u0915\u094b \u092c\u0939\u0941\u0924 \u0915\u092e \u091c\u0917\u0939 \u092c\u0938\u093e\u092f\u093e \u0917\u092f\u093e \u0925\u093e. \u0928\u0949\u0930\u094d\u0938 \u0938\u0917\u093e\u0938 \u092e\u0947\u0902 \u0935\u0947 \u0915\u0939\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u090f\u0930\u093f\u0915 \u0930\u0947\u0921 \u0939\u0924\u094d\u092f\u093e \u0915\u0947 \u0932\u093f\u090f \u0906\u0907\u0938\u0932\u0948\u0902\u0921 \u0938\u0947 \u0928\u093f\u0930\u094d\u0935\u093e\u0938\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0925\u093e, \u0914\u0930 \u0906\u0917\u0947 \u092a\u0936\u094d\u091a\u093f\u092e \u0915\u0940 \u092f\u093e\u0924\u094d\u0930\u093e \u0915\u0930\u0924\u0947 \u0938\u092e\u092f, \u0917\u094d\u0930\u0940\u0928\u0932\u0948\u0902\u0921 \u092e\u093f\u0932\u093e \u091c\u093f\u0938\u0947 \u0917\u094d\u0930\u0940\u0928\u0932\u0948\u0902\u0921 \u0928\u093e\u092e \u0926\u093f\u092f\u093e \u0917\u092f\u093e.", "audio_duration_s": 12.72453514739229, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.310442980104843, "dnsmos_sig": 3.6272350947551697, "dnsmos_bak": 4.027628467214979}
{"id": "nat_hi_2", "language": "hi", "text": "\u0910\u0938\u0940 \u0915\u094b\u0908 \u0935\u0948\u0936\u094d\u0935\u093f\u0915 \u092a\u0930\u093f\u092d\u093e\u0937\u093e \u0928\u0939\u0940\u0902 \u0939\u0948 \u091c\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u0930\u094d\u092e\u093f\u0924 \u0938\u093e\u092e\u093e\u0928 \u090f\u0902\u091f\u0940\u0915 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902. \u0915\u0941\u091b \u0915\u0930 \u090f\u091c\u0947\u0902\u0938\u093f\u092f\u093e\u0901 100 \u0938\u093e\u0932 \u0938\u0947 \u092a\u0941\u0930\u093e\u0928\u0947 \u0938\u093e\u092e\u093e\u0928 \u0915\u094b \u090f\u0902\u091f\u0940\u0915 \u0915\u0947 \u0924\u094c\u0930 \u092a\u0930 \u092a\u0930\u093f\u092d\u093e\u0937\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0902.", "audio_duration_s": 9.195102040816327, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.372997613161688, "dnsmos_sig": 3.654703429664072, "dnsmos_bak": 4.1081721021054145}
{"id": "nat_hi_3", "language": "hi", "text": "\u091f\u0947\u0932\u0940\u0935\u093f\u091c\u0928 \u0930\u093f\u092a\u094b\u0930\u094d\u091f\u094b\u0902 \u092e\u0947\u0902 \u092a\u094d\u0932\u093e\u0902\u091f \u0938\u0947 \u0928\u093f\u0915\u0932\u0928\u0947 \u0935\u093e\u0932\u093e \u0938\u092b\u0947\u0926 \u0927\u0941\u0906\u0901 \u0926\u093f\u0916\u093e\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964", "audio_duration_s": 4.08671201814059, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4466655928198477, "dnsmos_sig": 3.726232437777557, "dnsmos_bak": 4.129964731683418}
{"id": "nat_hi_4", "language": "hi", "text": "\u0907\u0902\u091f\u0930\u0928\u0947\u091f \u092a\u0930 \u092f\u0939 \u0916\u094b\u091c '\u0936\u0924\u094d\u0930\u0941\u0924\u093e\u092a\u0942\u0930\u094d\u0923 \u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923 \u092a\u093e\u0920\u094d\u092f\u0915\u094d\u0930\u092e' \u0915\u0947 \u0932\u093f\u090f \u0905\u0915\u094d\u0938\u0930 \u0906\u092a\u0915\u094b \u090f\u0915 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0915\u0902\u092a\u0928\u0940 \u0915\u093e \u092a\u0924\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0917\u0940\u0964", "audio_duration_s": 7.616145124716553, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.534123070153369, "dnsmos_sig": 3.7578410814991092, "dnsmos_bak": 4.211312044531033}
{"id": "nat_hi_5", "language": "hi", "text": "\u0905\u092a\u0928\u0940 \u0938\u0930\u0915\u093e\u0930 \u0915\u0947 \u0905\u0932\u093e\u0935\u093e \u0906\u092a \u0905\u0928\u094d\u092f \u0926\u0947\u0936\u094b\u0902 \u0915\u0940 \u0938\u0930\u0915\u093e\u0930\u094b\u0902 \u0915\u0940 \u0938\u0932\u093e\u0939 \u0932\u0947 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902. \u0939\u093e\u0932\u093e\u0901\u0915\u093f, \u0909\u0928\u0915\u0940 \u0938\u0932\u093e\u0939 \u0909\u0928\u0915\u0947 \u0928\u093e\u0917\u0930\u093f\u0915\u094b\u0902 \u0915\u094b \u0927\u094d\u092f\u093e\u0928 \u092e\u0947\u0902 \u0930\u0916\u0915\u0930 \u0926\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902.", "audio_duration_s": 7.894784580498866, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.41892460177462, "dnsmos_sig": 3.6543604408354757, "dnsmos_bak": 4.185980803450822}
{"id": "nat_hi_6", "language": "hi", "text": "\u092a\u094d\u0930\u093e\u091a\u0940\u0928\u0915\u093e\u0932 \u0938\u0947 \u0939\u0940 \u0932\u094b\u0917 \u0938\u094b\u0928\u0947, \u091a\u093e\u0901\u0926\u0940, \u0914\u0930 \u0924\u093e\u0902\u092c\u0947 \u091c\u0948\u0938\u0947 \u0930\u093e\u0938\u093e\u092f\u0928\u093f\u0915 \u0924\u0924\u094d\u0935\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0939\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0930\u0916\u0924\u0947 \u0939\u0948\u0902, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0907\u0928\u094d\u0939\u0947\u0902 \u092a\u094d\u0930\u0915\u0943\u0924\u093f \u092e\u0947\u0902 \u092e\u0942\u0932 \u0938\u094d\u0935\u0930\u0942\u092a \u092e\u0947\u0902 \u0922\u0942\u0901\u0922\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948 \u0914\u0930 \u0907\u0928\u094d\u0939\u0947\u0902 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u0909\u092a\u0915\u0930\u0923\u094b\u0902 \u0915\u0947 \u091c\u093c\u0930\u093f\u090f \u0922\u0942\u0901\u0922\u0928\u093e \u0905\u092a\u0947\u0915\u094d\u0937\u093e\u0915\u0943\u0924 \u0906\u0938\u093e\u0928 \u0939\u0948.", "audio_duration_s": 13.56045351473923, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.467825872432706, "dnsmos_sig": 3.6921021480642766, "dnsmos_bak": 4.170501504455892}
{"id": "nat_hi_7", "language": "hi", "text": "\u0907\u0938\u0947 \u0915\u0947\u092e\u093f\u0915\u0932 \u0915\u093e pH \u0915\u0939\u093e \u091c\u093e\u0924\u093e \u0939\u0948. \u0906\u092a \u0932\u093e\u0932 \u0917\u094b\u092d\u0940 \u0915\u0947 \u091c\u0942\u0938 \u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0915\u0947 \u090f\u0915 \u0938\u0902\u0915\u0947\u0924\u0915 \u092c\u0928\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902.", "audio_duration_s": 6.873106575963718, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4363487060498574, "dnsmos_sig": 3.648921768028734, "dnsmos_bak": 4.205330228041294}
{"id": "nat_hi_8", "language": "hi", "text": "\u0938\u092c\u0938\u0947 \u0928\u091c\u093c\u0926\u0940\u0915\u0940 \u0938\u093f\u0930\u0947 \u092a\u0930 \u0915\u094d\u0930\u0938\u094d\u091f \u0915\u0940 \u092e\u094b\u091f\u093e\u0908 \u0915\u0930\u0940\u092c 70 \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930 \u0939\u0948 \u0914\u0930 \u0938\u092c\u0938\u0947 \u0926\u0942\u0930 \u0915\u0947 \u0938\u093f\u0930\u0947 \u092a\u0930 \u092f\u0939 100 \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930 \u0939\u0948.", "audio_duration_s": 6.780226757369615, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.422449888261223, "dnsmos_sig": 3.6463002604547414, "dnsmos_bak": 4.173498286846055}
{"id": "nat_hi_9", "language": "hi", "text": "\u092f\u0939 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0906\u092e \u0924\u094c\u0930 \u092a\u0930 \u0907\u0938\u092e\u0947\u0902 \u0905\u0932\u094d\u092a\u093e\u0907\u0928 \u0936\u0948\u0932\u0940 \u0915\u0940 \u0938\u094d\u0915\u0940 \u091f\u0942\u0930\u093f\u0902\u0917 \u092f\u093e \u092e\u093e\u0909\u0902\u091f\u0947\u0928\u0940\u092f\u0930\u093f\u0902\u0917 \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940 \u0939\u0948, \u091c\u093f\u0938\u0947 \u0916\u0921\u093c\u0947 \u0907\u0932\u093e\u0915\u094b\u0902 \u092e\u0947\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u091c\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u092c\u0939\u0941\u0924 \u0915\u0921\u093c\u0940 \u0938\u094d\u0915\u0940 \u0914\u0930 \u092c\u0942\u091f \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948.", "audio_duration_s": 11.145578231292516, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.167307312318137, "dnsmos_sig": 3.6092912550870446, "dnsmos_bak": 3.7618580870187244}
{"id": "nat_hi_10", "language": "hi", "text": "\u092a\u0941\u0930\u0941\u0937\u094b\u0902 \u0915\u0947 \u0938\u094d\u091f\u0948\u0902\u0921\u093f\u0902\u0917 \u0938\u0941\u092a\u0930-\u091c\u0940 \u092e\u0947\u0902 \u0911\u0938\u094d\u091f\u094d\u0930\u0947\u0932\u093f\u092f\u093e \u0915\u0947 \u092e\u093f\u0936\u0947\u0932 \u0917\u094c\u0930\u0932\u0947 \u0917\u094d\u092f\u093e\u0930\u0939\u0935\u0947\u0902 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0939\u0947. \u091a\u0947\u0915 \u092a\u094d\u0930\u0924\u093f\u092f\u094b\u0917\u0940 \u0913\u0932\u094d\u0921\u0930\u093f\u091a \u091c\u0947\u0932\u093f\u0928\u0947\u0915 \u092a\u0941\u0930\u0941\u0937\u094b\u0902 \u0915\u0947 \u0938\u093f\u091f\u093f\u0902\u0917 \u0938\u0941\u092a\u0930-\u091c\u0940 \u092e\u0947\u0902 \u0938\u094b\u0932\u0939\u0935\u0947\u0902 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0939\u0947.", "audio_duration_s": 10.216780045351474, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3148685332476346, "dnsmos_sig": 3.6223097507999062, "dnsmos_bak": 4.025998259188034}
{"id": "nat_hi_11", "language": "hi", "text": "\u0915\u0947\u0935\u0932 \u0926\u094b \u0939\u092b\u093c\u094d\u0924\u094b\u0902 \u092e\u0947\u0902 \u0905\u092e\u0947\u0930\u093f\u0915\u093f\u092f\u094b\u0902 \u0914\u0930 \u092b\u093c\u094d\u0930\u0940 \u092b\u093c\u094d\u0930\u0947\u0902\u091a \u092c\u0932\u094b\u0902 \u0928\u0947 \u0926\u0915\u094d\u0937\u093f\u0923\u0940 \u092b\u093c\u094d\u0930\u093e\u0902\u0938 \u0915\u094b \u092e\u0941\u0915\u094d\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e \u0925\u093e \u0914\u0930 \u091c\u0930\u094d\u092e\u0928\u0940 \u0915\u0940 \u0913\u0930 \u092c\u0922\u093c \u0930\u0939\u0947 \u0925\u0947.", "audio_duration_s": 7.058866213151927, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.300840378362248, "dnsmos_sig": 3.658150010170447, "dnsmos_bak": 4.022824355009658}
{"id": "nat_hi_12", "language": "hi", "text": "MS, \u092c\u0940\u092e\u093e\u0930\u0940 \u0915\u0947\u0902\u0926\u094d\u0930\u0940\u092f \u0924\u0902\u0924\u094d\u0930\u093f\u0915\u093e \u0924\u0902\u0924\u094d\u0930 \u092a\u0930 \u0905\u0938\u0930 \u0915\u0930\u0924\u0940 \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0926\u093f\u092e\u093e\u0917, \u0938\u094d\u092a\u093e\u0907\u0928\u0932 \u0915\u0949\u0930\u094d\u0921 \u0914\u0930 \u0911\u092a\u094d\u091f\u093f\u0915 \u0928\u0930\u094d\u0935 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902.", "audio_duration_s": 7.337505668934241, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.330643086875134, "dnsmos_sig": 3.578781845660848, "dnsmos_bak": 4.146084174173568}
{"id": "nat_hi_13", "language": "hi", "text": "\u0939\u0930 \u0915\u094b\u0908 \u0938\u092e\u093e\u091c \u0938\u0947 \u091c\u0941\u0921\u093c\u093e \u0939\u094b\u0924\u093e \u0939\u0948 \u0914\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u0930\u094d\u091f \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948. \u0932\u0917\u092d\u0917 \u0938\u092d\u0940 \u0932\u094b\u0917 \u091f\u094d\u0930\u093e\u0902\u0938\u092a\u094b\u0930\u094d\u091f \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0936\u093f\u0915\u093e\u092f\u0924 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902.", "audio_duration_s": 7.894784580498866, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.299974823608873, "dnsmos_sig": 3.5920802697645318, "dnsmos_bak": 4.056776643949695}
{"id": "nat_hi_14", "language": "hi", "text": "\u090f\u0915 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0935\u093f\u0915\u0938\u093f\u0924 \u090f\u0925\u0932\u0940\u091f \u0915\u0940 \u0924\u0930\u0939, \u092c\u093e\u0918 \u091a\u0922\u093c\u093e\u0908 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948 (\u0939\u093e\u0932\u093e\u0901\u0915\u093f \u0905\u091a\u094d\u091b\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0928\u0939\u0940\u0902), \u0924\u0948\u0930 \u0938\u0915\u0924\u093e \u0939\u0948, \u092c\u0921\u093c\u0940 \u0926\u0942\u0930\u0940 \u0924\u0915 \u091b\u0932\u093e\u0902\u0917 \u0932\u0917\u093e \u0938\u0915\u0924\u093e \u0939\u0948 \u0914\u0930 \u090f\u0915 \u0936\u0915\u094d\u0924\u093f\u0936\u093e\u0932\u0940 \u092e\u0928\u0941\u0937\u094d\u092f \u0915\u0947 \u092a\u093e\u0901\u091a \u0917\u0941\u0928\u093e \u092c\u0932 \u0915\u0947 \u0938\u093e\u0925 \u0916\u0940\u0902\u091a \u0938\u0915\u0924\u093e \u0939\u0948.", "audio_duration_s": 11.702857142857143, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.543431856078699, "dnsmos_sig": 3.7517123285440643, "dnsmos_bak": 4.220754672104376}
{"id": "nat_hi_15", "language": "hi", "text": "\u0935\u093f\u0936\u0947\u0937 \u0930\u0942\u092a \u0938\u0947 \u0938\u0935\u093e\u0928\u093e \u092a\u0930 \u092c\u0947\u0939\u0924\u0930\u0940\u0928 \u0905\u092b\u093c\u094d\u0930\u0940\u0915\u0940 \u0935\u0928\u094d\u092f \u091c\u0940\u0935\u0928 \u0915\u094b \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0930\u0942\u092a \u0938\u0947 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0938\u092b\u093c\u093e\u0930\u0940 \u0936\u092c\u094d\u0926 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948.", "audio_duration_s": 7.523265306122449, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3827450172393037, "dnsmos_sig": 3.6713746341843447, "dnsmos_bak": 4.097816185921504}
{"id": "nat_hi_16", "language": "hi", "text": "\u0917\u0902\u092d\u0940\u0930 \u092e\u094c\u0938\u092e \u0915\u093f\u0938\u0940 \u092d\u0940 \u0916\u0924\u0930\u0928\u093e\u0915 \u092e\u094c\u0938\u092e\u0940 \u0918\u091f\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u0935\u0930\u094d\u0917\u0940\u092f \u0936\u092c\u094d\u0926 \u0939\u0948 \u091c\u093f\u0938\u092e\u0947\u0902 \u0928\u0941\u0915\u0938\u093e\u0928, \u0917\u0902\u092d\u0940\u0930 \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0935\u094d\u092f\u0935\u0927\u093e\u0928, \u092f\u093e \u092e\u093e\u0928\u0935 \u091c\u0940\u0935\u0928 \u0915\u0940 \u0939\u093e\u0928\u093f \u0915\u0940 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u0939\u0948\u0964", "audio_duration_s": 8.544943310657596, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.316119487509842, "dnsmos_sig": 3.726020082449445, "dnsmos_bak": 3.905804708709254}
{"id": "nat_hi_17", "language": "hi", "text": "\u0939\u093e\u0932\u093e\u0901\u0915\u093f \u092f\u0939 \u0905\u0915\u0947\u0932\u093e \u0928\u0939\u0940\u0902 \u0939\u0948, \u092a\u094d\u0930\u092f\u094b\u0917 \u0915\u0930\u0928\u093e, \u0914\u0930 \u092a\u094d\u0930\u092f\u094b\u0917 \u090f\u0915 \u0910\u0938\u093e \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u0939\u094b\u0924\u093e \u0939\u0948 \u091c\u093f\u0938\u0915\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0915\u0947 \u090f\u0915 \u092f\u093e \u0907\u0938\u0938\u0947 \u091c\u093c\u094d\u092f\u093e\u0926\u093e \u0938\u0902\u092d\u093e\u0935\u093f\u0924 \u092a\u0930\u093f\u0915\u0932\u094d\u092a\u0928\u093e\u0913\u0902 \u0915\u094b \u0916\u093c\u0924\u094d\u092e \u0915\u0930\u0928\u0947, \u0938\u0935\u093e\u0932 \u0915\u0930\u0928\u0947, \u0914\u0930 \u0905\u0935\u0932\u094b\u0915\u0928 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092d\u0940 \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u0936\u094b\u0927 \u0915\u094b \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928 \u092e\u093f\u0932\u0924\u093e \u0939\u0948.", "audio_duration_s": 12.538775510204081, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4586400442992815, "dnsmos_sig": 3.741284650102042, "dnsmos_bak": 4.102405015454903}
{"id": "nat_hi_18", "language": "hi", "text": "\u0915\u0948\u0932\u094d\u0936\u093f\u092f\u092e \u0914\u0930 \u092a\u094b\u091f\u0948\u0936\u093f\u092f\u092e \u091c\u0948\u0938\u0947 \u0924\u0924\u094d\u0935\u094b\u0902 \u0915\u094b \u0927\u093e\u0924\u0941 \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092c\u0947\u0936\u0915, \u091a\u093e\u0902\u0926\u0940 \u0914\u0930 \u0938\u094b\u0928\u0947 \u091c\u0948\u0938\u0940 \u0927\u093e\u0924\u0941\u090f\u0902 \u092d\u0940 \u0939\u0948\u0902\u0964", "audio_duration_s": 5.944308390022676, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.5253310962766538, "dnsmos_sig": 3.7348182608815392, "dnsmos_bak": 4.210236962539068}
{"id": "nat_hi_19", "language": "hi", "text": "\u0939\u0949\u091f \u091a\u0949\u0915\u0932\u0947\u091f \u092c\u0947\u0932\u094d\u091c\u093f\u092f\u092e \u0915\u0947 \u092e\u093e\u0928\u0915\u094b\u0902 \u092a\u0930 \u092c\u0928\u0940 \u0939\u0948. \u092b\u0932\u094b\u0902 \u0915\u093e \u091c\u0942\u0938 \u092e\u0939\u0902\u0917\u093e \u0939\u0948 \u0932\u0947\u0915\u093f\u0928 \u092c\u0939\u0941\u0924 \u0905\u091a\u094d\u091b\u093e \u0939\u0948.", "audio_duration_s": 5.201269841269841, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.32626198119454, "dnsmos_sig": 3.604766189394422, "dnsmos_bak": 4.0862623256231885}
{"id": "nat_hi_20", "language": "hi", "text": "\u091c\u093f\u0938 \u0938\u092e\u092f \u0918\u091f\u0928\u093e\u090f\u0901 \u0939\u0941\u0908 \u0909\u0938\u0915\u0947 \u092f\u0941\u0917 \u0915\u094b \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0930\u0942\u092a \u0938\u0947 \u092f\u0942\u0930\u094b\u092a \u0915\u0947 \u0907\u0924\u093f\u0939\u093e\u0938 \u092e\u0947\u0902 11\u0935\u0940\u0902, 12\u0935\u0940\u0902 \u0914\u0930 13\u0935\u0940\u0902 \u0938\u0926\u0940 (AD 1000-1300) \u092e\u0947\u0902 \u092f\u0942\u0930\u094b\u092a\u093f\u092f\u0928 \u0907\u0924\u093f\u0939\u093e\u0938 \u0915\u0947 \u0909\u091a\u094d\u091a \u092e\u0927\u094d\u092f \u092f\u0941\u0917 \u0915\u0940 \u0905\u0935\u0927\u093f \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092c\u0924\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948.", "audio_duration_s": 12.538775510204081, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.1721775461086104, "dnsmos_sig": 3.557669675554783, "dnsmos_bak": 3.8936170715186145}
{"id": "nat_hi_21", "language": "hi", "text": "\u0915\u0941\u091b \u0932\u094b\u0917\u094b\u0902 \u092f\u0947 \u0938\u094b\u091a\u0924\u0947 \u0925\u0947 \u0915\u0940 \u0915\u093f \u0935\u0939 \u0938\u0939\u0940 \u0925\u093e \u0932\u0947\u0915\u093f\u0928 \u092c\u0939\u0941\u0924 \u0938\u0947 \u0932\u094b\u0917 \u0907\u0938\u0915\u0947 \u0935\u093f\u092a\u0930\u0940\u0924 \u092e\u093e\u0928\u0924\u0947 \u0925\u0947; \u0915\u0940 \u0938\u094c\u0930 \u092e\u0902\u0921\u0932 \u0938\u0942\u0930\u094d\u092f (\u0914\u0930 \u092f\u0939\u093e\u0902 \u0924\u0915 \u0915\u093f \u0905\u0928\u094d\u092f \u0938\u093f\u0924\u093e\u0930\u094b\u0902) \u0938\u0939\u093f\u0924 \u092a\u0943\u0925\u094d\u0935\u0940 \u0915\u0947 \u091a\u093e\u0930\u094b\u0902 \u0914\u0930 \u091a\u0915\u094d\u0915\u0930 \u0932\u0917\u0924\u093e \u0925\u093e \u0964", "audio_duration_s": 10.402539682539683, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.249011260182648, "dnsmos_sig": 3.620472118465401, "dnsmos_bak": 3.967202640156674}
{"id": "nat_hi_22", "language": "hi", "text": "\u092f\u0926\u093f \u0906\u092a \u0915\u0947\u0935\u0932 \u0936\u093f\u092a\u092c\u094b\u0930\u094d\u0921 \u092d\u094d\u0930\u092e\u0923 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0915\u093f\u0928\u093e\u0930\u0947 \u0924\u0915 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0906\u092a\u0915\u094b \u090f\u0915 \u0905\u0932\u0917 \u0935\u0940\u091c\u093c\u093e \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u094b\u0917\u0940 (2009 \u0924\u0915).", "audio_duration_s": 7.7090249433106575, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.514600658699632, "dnsmos_sig": 3.7353581327829577, "dnsmos_bak": 4.210359118376041}
{"id": "nat_hi_23", "language": "hi", "text": "\u092f\u0939\u0942\u0926\u0940 \u0914\u0930 \u0917\u0948\u0930-\u092f\u0939\u0942\u0926\u0940 \u0915\u0940 \u0924\u0930\u0939, \u0905\u092d\u0940 \u092d\u0940 \u0910\u0938\u0947 \u0915\u0908 \u092a\u0941\u0930\u0941\u0937 \u0914\u0930 \u092e\u0939\u093f\u0932\u093e\u090f\u0902 \u091c\u0940\u0935\u093f\u0924 \u0939\u0948\u0902 \u091c\u094b \u0909\u0938 \u0938\u092e\u092f \u092c\u091a\u0928\u0947 \u092e\u0947\u0902 \u0938\u092b\u0932 \u0930\u0939\u0947 \u0914\u0930 \u0915\u0908 \u091c\u093f\u0928\u0915\u0947 \u092a\u094d\u0930\u093f\u092f\u091c\u0928\u094b\u0902 \u0915\u094b \u092e\u093e\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u092f\u093e \u0909\u0928\u0915\u0947 \u092e\u0930\u0928\u0947 \u0924\u0915 \u0909\u0928\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0935\u093e\u092f\u093e \u0917\u092f\u093e.", "audio_duration_s": 11.052698412698414, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4204037067552893, "dnsmos_sig": 3.7079334863512807, "dnsmos_bak": 4.078742643066854}
{"id": "nat_hi_24", "language": "hi", "text": "\u0907\u091f\u0948\u0932\u093f\u092f\u0928 \u092d\u0940 \u0930\u094b\u091c\u093c\u093e\u0928\u093e \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0939\u094b\u0928\u0947 \u0935\u093e\u0932\u0940 \u092d\u093e\u0937\u093e \u0939\u0948 \u091c\u093f\u0938\u0947 \u0930\u093e\u091c\u094d\u092f \u092e\u0947\u0902 \u0915\u093e\u092e \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0905\u0927\u093f\u0915\u093e\u0902\u0936 \u0932\u094b\u0917 \u0909\u092a\u092f\u094b\u0917 \u092e\u0947\u0902 \u0932\u093e\u0924\u0947 \u0939\u0948\u0902, \u091c\u092c\u0915\u093f \u0932\u0947\u091f\u093f\u0928 \u0915\u093e \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0930\u0938\u094d\u092e\u094b\u0902 \u092e\u0947\u0902 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948.", "audio_duration_s": 9.47374149659864, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.36243119573328, "dnsmos_sig": 3.6670817852971744, "dnsmos_bak": 4.100745448845987}
{"id": "nat_hi_25", "language": "hi", "text": "\u0932\u094b\u0917 \u092f\u0939 \u0905\u0928\u0941\u092e\u093e\u0928 \u0928\u0939\u0940\u0902 \u0932\u0917\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0918\u0930 \u0932\u094c\u091f\u0928\u0947 \u0935\u093e\u0932\u0947 \u092f\u093e\u0924\u094d\u0930\u093f\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0927\u0948\u0930\u094d\u092f \u0914\u0930 \u0938\u092e\u091d \u092d\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948.", "audio_duration_s": 5.6656689342403626, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.375308859888825, "dnsmos_sig": 3.6864488636010746, "dnsmos_bak": 4.094842839386324}
