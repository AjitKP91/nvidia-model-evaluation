{"id": "nat_ko_38", "language": "ko", "text": "\uadf8\ub0a0 \ubc24 \ub3d9\uc548 \uc9c0\uae08\uc740 '\ub358\ub7a9 \ube0c\ub85c\ub4dc\uc0ac\uc774\ub4dc'\ub77c\uace0 \ubd88\ub9ac\ub294 \uc778\uc1c4\ubb3c\uc774 150\uc5d0\uc11c 200\uc7a5 \ub9cc\ub4e4\uc5b4\uc84c\ub2e4.", "audio_duration_s": 6.315827664399093, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.346134642955107, "dnsmos_sig": 3.595456380043149, "dnsmos_bak": 4.121379571647959}
