{"id": "nat_hi_27", "language": "hi", "text": "\u0907\u0902\u091f\u0930\u0928\u0947\u091f, \u0932\u094b\u0917\u094b\u0902 \u0914\u0930 \u0905\u0902\u0924\u0930-\u092a\u0930\u0938\u094d\u092a\u0930 \u0938\u0902\u091a\u093e\u0930, \u0926\u094b\u0928\u094b\u0902 \u0915\u0947 \u0924\u0924\u094d\u0935\u094b\u0902 \u0915\u094b \u092e\u093f\u0932\u093e\u0924\u093e \u0939\u0948.", "audio_duration_s": 4.6439909297052155, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.378684224334024, "dnsmos_sig": 3.6396387044844767, "dnsmos_bak": 4.128194157347344}
{"id": "nat_hi_28", "language": "hi", "text": "\u0924\u0915\u0928\u0940\u0915\u0940 \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u0923 \u0915\u0940 \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0935\u094d\u092f\u093e\u0916\u094d\u092f\u093e\u090f\u0901 \u0926\u094b \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0935\u093f\u091a\u093e\u0930\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u092c\u0924\u093e\u0924\u0940 \u0939\u0948\u0902: \u0924\u0915\u0928\u0940\u0915\u0940 \u0935\u093f\u0915\u093e\u0938 \u092a\u0930 \u0938\u093e\u0902\u0938\u094d\u0915\u0943\u0924\u093f\u0915 \u092f\u093e \u0930\u093e\u091c\u0928\u0940\u0924\u093f\u0915 \u0905\u0938\u0930 \u0915\u093e \u0915\u094b\u0908 \u092d\u0940 \u092a\u094d\u0930\u092d\u093e\u0935 \u0928\u0939\u0940\u0902 \u092a\u0921\u093c\u0924\u093e \u0939\u0948 \u0914\u0930 \u092a\u0930\u093f\u0923\u093e\u092e\u0938\u094d\u0935\u0930\u0942\u092a \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u091c\u093e\u092f \u0935\u0939 \u0924\u0915\u0928\u0940\u0915 \u0928\u093f\u0939\u093f\u0924 \u0938\u092e\u093e\u091c\u094b\u0902 \u0915\u094b \u201c\u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924\u201d \u0915\u0930\u0924\u0940 \u0939\u0948.", "audio_duration_s": 15.32517006802721, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4060349314651592, "dnsmos_sig": 3.652909929593888, "dnsmos_bak": 4.172392915108854}
{"id": "nat_hi_29", "language": "hi", "text": "\u0915\u0947\u0935\u0932 \u0926\u094b \u0939\u092b\u093c\u094d\u0924\u094b\u0902 \u092e\u0947\u0902 \u0905\u092e\u0947\u0930\u093f\u0915\u093f\u092f\u094b\u0902 \u0914\u0930 \u092b\u093c\u094d\u0930\u0940 \u092b\u093c\u094d\u0930\u0947\u0902\u091a \u092c\u0932\u094b\u0902 \u0928\u0947 \u0926\u0915\u094d\u0937\u093f\u0923\u0940 \u092b\u093c\u094d\u0930\u093e\u0902\u0938 \u0915\u094b \u092e\u0941\u0915\u094d\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e \u0925\u093e \u0914\u0930 \u091c\u0930\u094d\u092e\u0928\u0940 \u0915\u0940 \u0913\u0930 \u092c\u0922\u093c \u0930\u0939\u0947 \u0925\u0947.", "audio_duration_s": 7.244625850340136, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.1527450889664865, "dnsmos_sig": 3.5189857133767197, "dnsmos_bak": 3.9291215109314037}
{"id": "nat_hi_30", "language": "hi", "text": "\u092f\u0942\u0928\u093f\u0935\u0930\u094d\u0938\u093f\u091f\u0940 \u0911\u092b\u093c \u0921\u0902\u0921\u0940 \u0915\u0947 \u092a\u094d\u0930\u094b\u092b\u093c\u0947\u0938\u0930 \u092a\u093e\u092e\u0947\u0932\u093e \u092b\u093c\u0930\u094d\u0917\u094d\u092f\u0942\u0938\u0928 \u0932\u093f\u0916\u0924\u0947 \u0939\u0948\u0902, \u201c\u0905\u0917\u0930 \u0938\u0902\u0926\u093f\u0917\u094d\u0927\u094b\u0902 \u0915\u0947 \u092b\u093c\u094b\u091f\u094b \u0906\u0926\u093f \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u092a\u0924\u094d\u0930\u0915\u093e\u0930\u094b\u0902 \u0915\u094b \u092f\u0939 \u0916\u093c\u0924\u0930\u0928\u093e\u0915 \u092e\u093e\u0930\u094d\u0917 \u092a\u0930 \u091a\u0932\u0928\u093e \u0932\u0917\u0924\u093e \u0939\u0948\u201d.", "audio_duration_s": 9.009342403628118, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.5013108458589968, "dnsmos_sig": 3.7227190229514635, "dnsmos_bak": 4.212512464945275}
{"id": "nat_hi_31", "language": "hi", "text": "\u0909\u0928\u0915\u093e \u0938\u093f\u0902\u0917\u093e\u092a\u0941\u0930 \u0915\u0947 \u0909\u092a-\u092a\u094d\u0930\u0927\u093e\u0928 \u092e\u0902\u0924\u094d\u0930\u0940 \u0935\u094b\u0902\u0917 \u0915\u093e\u0928 \u0938\u0947\u0902\u0917 \u0928\u0947 \u0938\u094d\u0935\u093e\u0917\u0924 \u0915\u093f\u092f\u093e \u0914\u0930 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0938\u093f\u0902\u0917\u093e\u092a\u0941\u0930 \u0915\u0947 \u092a\u094d\u0930\u0927\u093e\u0928\u092e\u0902\u0924\u094d\u0930\u0940 \u0932\u0940 \u0938\u093f\u090f\u0928 \u0932\u0942\u0902\u0917 \u0915\u0947 \u0938\u093e\u0925 \u0935\u094d\u092f\u093e\u092a\u093e\u0930 \u0914\u0930 \u0906\u0924\u0902\u0915\u0935\u093e\u0926 \u0915\u0947 \u092e\u093e\u092e\u0932\u0947 \u092a\u0930 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0940.", "audio_duration_s": 9.47374149659864, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4390992917509857, "dnsmos_sig": 3.7231412577741763, "dnsmos_bak": 4.146002725143682}
{"id": "nat_hi_32", "language": "hi", "text": "\u0935\u093f\u0916\u0902\u0921\u0928 \u092c\u092e \u0907\u0938 \u0938\u093f\u0926\u094d\u0927\u093e\u0902\u0924 \u092a\u0930 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948 \u0915\u093f \u0915\u0908 \u092a\u094d\u0930\u094b\u091f\u0949\u0928 \u0914\u0930 \u0928\u094d\u092f\u0942\u091f\u094d\u0930\u0949\u0928 \u0935\u093e\u0932\u0947 \u090f\u0915 \u0928\u093e\u092d\u093f\u0915 \u0915\u094b \u090f\u0915 \u0938\u093e\u0925 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090a\u0930\u094d\u091c\u093e \u0932\u0917\u0924\u0940 \u0939\u0948\u0964", "audio_duration_s": 7.337505668934241, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3531566610005363, "dnsmos_sig": 3.6393300681111342, "dnsmos_bak": 4.107380755061144}
{"id": "nat_hi_33", "language": "hi", "text": "\u0910\u0938\u093e \u092e\u093e\u0928\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u092a\u0947\u0930\u093f\u0938 \u0915\u0947 \u0928\u093f\u0935\u093e\u0938\u0940 \u0905\u0939\u0902\u0915\u093e\u0930\u0940, \u0905\u0938\u092d\u094d\u092f \u0914\u0930 \u0905\u092d\u093f\u092e\u093e\u0928\u0940 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964", "audio_duration_s": 4.365351473922902, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.291609347274188, "dnsmos_sig": 3.6615653465003035, "dnsmos_bak": 3.9699829935771374}
{"id": "nat_hi_34", "language": "hi", "text": "1963 \u092e\u0947\u0902 \u092c\u093e\u0901\u0927 \u092c\u0928\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u092e\u094c\u0938\u092e\u0940 \u092c\u093e\u0922\u093c \u091c\u094b \u092a\u0942\u0930\u0947 \u0928\u0926\u0940 \u092e\u0947\u0902 \u0924\u0932\u091b\u091f \u092b\u0948\u0932\u093e \u0926\u0947\u0917\u0940 \u0935\u0939 \u0930\u0941\u0915 \u0917\u0908 \u0925\u0940.", "audio_duration_s": 6.130068027210885, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.328353546362696, "dnsmos_sig": 3.681857693425858, "dnsmos_bak": 4.053828484440884}
{"id": "nat_hi_35", "language": "hi", "text": "\u092f\u0939 \u0911\u0930\u094b\u0930\u093e \u092c\u094b\u0930\u0947\u0932\u093f\u0938 \u0915\u094b \u0926\u0947\u0916\u0928\u0947 \u0915\u093e \u090f\u0915 \u0905\u091a\u094d\u091b\u093e \u0905\u0935\u0938\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948, \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u0906\u0915\u093e\u0936 \u092e\u0947\u0902 \u0909\u0938 \u0938\u092e\u092f \u0905\u0902\u0927\u0915\u093e\u0930 \u0938\u093e \u0939\u0940 \u0930\u0939\u0947\u0917\u093e\u0964", "audio_duration_s": 6.501587301587302, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3136679278115913, "dnsmos_sig": 3.6423476002339923, "dnsmos_bak": 4.028828957881993}
{"id": "nat_hi_36", "language": "hi", "text": "\u092f\u0939 \u0936\u0939\u0930 \u0926\u0947\u0936 \u0915\u0947 \u092c\u093e\u0915\u0940 \u0936\u0939\u0930\u094b\u0902 \u0938\u0947 \u0905\u0932\u0917 \u0939\u0948 \u0915\u094d\u092f\u094b\u0902\u0915\u093f \u092f\u0939 \u0915\u093f\u0938\u0940 \u0905\u092b\u094d\u0930\u0940\u0915\u0940 \u0936\u0939\u0930 \u0915\u0940 \u092c\u091c\u093e\u092f \u0905\u0930\u092c \u0936\u0939\u0930 \u0932\u0917\u0924\u093e \u0939\u0948.", "audio_duration_s": 5.6656689342403626, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 2.9628702332904293, "dnsmos_sig": 3.482120101639249, "dnsmos_bak": 3.6161387205232964}
{"id": "nat_hi_37", "language": "hi", "text": "\u092a\u0941\u0932\u093f\u0938 \u0905\u0927\u0940\u0915\u094d\u0937\u0915 \u091a\u0902\u0926\u094d\u0930 \u0936\u0947\u0916\u0930 \u0938\u094b\u0932\u0902\u0915\u0940 \u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u0906\u0930\u094b\u092a\u0940 \u0922\u0915\u0947 \u0939\u0941\u090f \u091a\u0947\u0939\u0930\u0947 \u0915\u0947 \u0938\u093e\u0925 \u0905\u0926\u093e\u0932\u0924 \u092e\u0947\u0902 \u092a\u0947\u0936 \u0939\u0941\u090f \u0925\u0947.", "audio_duration_s": 5.851428571428571, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.436019905689722, "dnsmos_sig": 3.7035384518317693, "dnsmos_bak": 4.117885202789809}
{"id": "nat_hi_38", "language": "hi", "text": "\u091c\u093c\u094d\u092f\u093e\u0926\u093e \u092a\u0930\u0902\u092a\u0930\u093e\u0917\u0924 \u091a\u0930\u094d\u091a\u094b\u0902 \u092e\u0947\u0902 \u0908\u0938\u094d\u091f\u0930 \u0938\u092a\u094d\u0924\u093e\u0939\u093e\u0902\u0924 \u092e\u0947\u0902 \u0936\u0928\u093f\u0935\u093e\u0930 \u0930\u093e\u0924 \u0915\u094b \u0908\u0938\u094d\u091f\u0930 \u0935\u093f\u091c\u093f\u0932 \u0915\u093e \u0906\u092f\u094b\u091c\u0928 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0932\u094b\u0917 \u0915\u094d\u0930\u093f\u0938 \u0915\u0947 \u092a\u0941\u0928\u0930\u094d\u091c\u0928\u094d\u092e \u0915\u093e \u0909\u0924\u094d\u0938\u0935 \u092e\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0927\u0940 \u0930\u093e\u0924 \u0915\u0947 \u0938\u092e\u092f \u0909\u0924\u094d\u0938\u0935 \u092e\u0928\u093e\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902.", "audio_duration_s": 11.42421768707483, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.411764874626005, "dnsmos_sig": 3.6770356617494633, "dnsmos_bak": 4.163281539719852}
{"id": "nat_hi_39", "language": "hi", "text": "29 \u0935\u0930\u094d\u0937\u0940\u092f \u0921\u0949. \u092e\u0932\u093e\u0930 \u092c\u093e\u0932\u093e\u0938\u0941\u092c\u094d\u0930\u092e\u0923\u094d\u092f\u092e \u0938\u093f\u0928\u0938\u093f\u0928\u093e\u091f\u0940 \u0915\u0947 \u0909\u0924\u094d\u0924\u0930 \u092e\u0947\u0902 \u0932\u0917\u092d\u0917 15 \u092e\u0940\u0932 \u0915\u0940 \u0926\u0942\u0930\u0940 \u092a\u0930 \u090f\u0915 \u0909\u092a\u0928\u0917\u0930 \u092c\u094d\u0932\u0942 \u0910\u0936, \u0913\u0939\u093f\u092f\u094b \u092e\u0947\u0902 \u092e\u093f\u0932\u0947, \u091c\u094b \u090f\u0915 \u091f\u0940-\u0936\u0930\u094d\u091f \u0914\u0930 \u0905\u0902\u0921\u0930\u0935\u093f\u092f\u0930 \u092e\u0947\u0902 \u0938\u0921\u093c\u0915 \u0915\u0947 \u0915\u093f\u0928\u093e\u0930\u0947 \u092c\u0939\u0941\u0924 \u0905\u0927\u093f\u0915 \u0928\u0936\u0947 \u0915\u0940 \u0939\u093e\u0932\u0924 \u092e\u0947\u0902 \u091c\u092e\u0940\u0928 \u092a\u0930 \u092a\u095c\u0947 \u0925\u0947\u0964", "audio_duration_s": 13.931972789115646, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 2.9617347434816095, "dnsmos_sig": 3.4772431632476763, "dnsmos_bak": 3.6538921847219026}
{"id": "nat_hi_40", "language": "hi", "text": "\u092c\u093e\u0926 \u092e\u0947\u0902 \u0909\u0928\u094d\u0939\u0947\u0902 \u0915\u0948\u092e\u094d\u092c\u094d\u0930\u093f\u091c \u092e\u0947\u0902 \u090f\u0921\u0947\u0928\u092c\u094d\u0930\u0941\u0915 \u0915\u0947 \u0905\u0938\u094d\u092a\u0924\u093e\u0932 \u092e\u0947\u0902 \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u0924\u0930\u093f\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e.", "audio_duration_s": 4.551111111111111, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.2043455040019393, "dnsmos_sig": 3.5987653914245517, "dnsmos_bak": 3.9057274885743185}
{"id": "nat_hi_41", "language": "hi", "text": "\u0924\u0940\u0938\u0930\u0940 \u0936\u0924\u093e\u092c\u094d\u0926\u0940 \u0908\u0938\u093e \u092a\u0942\u0930\u094d\u0935 \u092e\u0947\u0902 \u092e\u093f\u0938\u094d\u0930\u093f\u092f\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u093f\u0930\u094d\u092e\u093f\u0924, \u0917\u094d\u0930\u0947\u091f \u092a\u093f\u0930\u093e\u092e\u093f\u0921 \u092e\u0943\u0924 \u092b\u093f\u0930\u094c\u0928 \u0915\u093e \u0938\u092e\u094d\u092e\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u0930\u094d\u092e\u093f\u0924 \u0915\u0908 \u092c\u0921\u093c\u0940 \u092a\u093f\u0930\u093e\u092e\u093f\u0921 \u0938\u0902\u0930\u091a\u0928\u093e\u0913\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0939\u0948\u0964", "audio_duration_s": 9.845260770975056, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.459966094623403, "dnsmos_sig": 3.692669637639083, "dnsmos_bak": 4.190821505042398}
{"id": "nat_hi_42", "language": "hi", "text": "\u092e\u0939\u093f\u0932\u093e\u090f\u0901: \u092f\u0939 \u0905\u0928\u0941\u0936\u0902\u0938\u093e \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u0915\u094b\u0908 \u092d\u0940 \u092e\u0939\u093f\u0932\u093e \u092f\u093e\u0924\u094d\u0930\u0940 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0935\u0948\u0935\u093e\u0939\u093f\u0915 \u0938\u094d\u0925\u093f\u0924\u093f \u0915\u0947 \u092c\u093e\u0935\u091c\u0942\u0926 \u0915\u0939\u0924\u0940 \u0939\u0948 \u0915\u093f \u0935\u0939 \u0935\u093f\u0935\u093e\u0939\u093f\u0924 \u0939\u0948.", "audio_duration_s": 6.965986394557823, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.513789488090861, "dnsmos_sig": 3.730964010882137, "dnsmos_bak": 4.209387498981505}
{"id": "nat_hi_43", "language": "hi", "text": "\u092d\u0935\u0928\u094b\u0902 \u0915\u0940 \u092a\u0930\u0947\u0921 \u091c\u093f\u0938\u0928\u0947 \u0939\u093e\u0901\u0917\u0915\u093e\u0901\u0917 \u0915\u0940 \u0938\u094d\u0915\u093e\u092f\u0932\u093e\u0907\u0928 \u0915\u094b \u091a\u092e\u091a\u092e\u093e\u0924\u0947 \u092c\u093e\u0930 \u091a\u093e\u0930\u094d\u091f \u0915\u0940 \u0924\u0930\u0939 \u092c\u0928\u093e\u092f\u093e \u0939\u0948, \u0909\u0938\u0928\u0947 \u0935\u093f\u0915\u094d\u091f\u094b\u0930\u093f\u092f\u093e \u0939\u093e\u0930\u094d\u092c\u0930 \u0915\u0947 \u092a\u093e\u0928\u0940 \u0915\u0940 \u092e\u094c\u091c\u093c\u0942\u0926\u0917\u0940 \u0915\u094b \u0926\u0947\u0916\u0928\u0947 \u0932\u093e\u092f\u0915 \u092c\u0928\u093e\u092f\u093e \u0939\u0948.", "audio_duration_s": 8.359183673469389, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3767421460943483, "dnsmos_sig": 3.6895488973701815, "dnsmos_bak": 4.030818960767166}
{"id": "nat_hi_44", "language": "hi", "text": "\u0917\u0902\u092d\u0940\u0930 \u092e\u094c\u0938\u092e \u0915\u093f\u0938\u0940 \u092d\u0940 \u0916\u0924\u0930\u0928\u093e\u0915 \u092e\u094c\u0938\u092e\u0940 \u0918\u091f\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u0935\u0930\u094d\u0917\u0940\u092f \u0936\u092c\u094d\u0926 \u0939\u0948 \u091c\u093f\u0938\u092e\u0947\u0902 \u0928\u0941\u0915\u0938\u093e\u0928, \u0917\u0902\u092d\u0940\u0930 \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0935\u094d\u092f\u0935\u0927\u093e\u0928, \u092f\u093e \u092e\u093e\u0928\u0935 \u091c\u0940\u0935\u0928 \u0915\u0940 \u0939\u093e\u0928\u093f \u0915\u0940 \u0938\u0902\u092d\u093e\u0935\u0928\u093e \u0939\u0948\u0964", "audio_duration_s": 8.452063492063493, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.1644419691443844, "dnsmos_sig": 3.6618053094939618, "dnsmos_bak": 3.7716224026321576}
{"id": "nat_hi_45", "language": "hi", "text": "\u0938\u094d\u092a\u094d\u0930\u093f\u0902\u0917\u092c\u094b\u0915\u094d\u0938 \u0915\u0947 \u0932\u093f\u090f, \u0907\u0938\u0928\u0947 \u092a\u093e\u0902\u091a-\u092e\u0948\u091a\u094b\u0902 \u0915\u0940 \u0939\u093e\u0930 \u0915\u093e \u0938\u093f\u0932\u0938\u093f\u0932\u093e \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e.", "audio_duration_s": 4.272471655328798, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.1975760432744704, "dnsmos_sig": 3.552378281520297, "dnsmos_bak": 3.9403725025138816}
{"id": "nat_hi_46", "language": "hi", "text": "\u0932\u094b\u0917 \u0905\u092c \u0915\u0902\u092a\u094d\u092f\u0942\u091f\u0930 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 \u0938\u0902\u0926\u0947\u0936 \u0932\u093f\u0916\u0924\u0947 \u0939\u0948\u0902, \u0936\u093e\u0930\u094d\u092a\u0928\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u0939\u0940\u0902 \u092a\u095c\u0924\u0940\u0964", "audio_duration_s": 5.108390022675737, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3171674889385994, "dnsmos_sig": 3.569742424726097, "dnsmos_bak": 4.18811665022875}
{"id": "nat_hi_47", "language": "hi", "text": "\u0939\u093e\u0902\u0917\u0915\u093e\u0902\u0917 \u0926\u094d\u0935\u0940\u092a \u0939\u093e\u0902\u0917\u0915\u093e\u0902\u0917 \u0915\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u094b \u0909\u0938\u0915\u093e \u0928\u093e\u092e \u0926\u0947\u0924\u093e \u0939\u0948 \u0914\u0930 \u092f\u0939 \u0935\u0939 \u0938\u094d\u0925\u093e\u0928 \u0939\u0948 \u091c\u093f\u0938\u0947 \u0915\u0908 \u092a\u0930\u094d\u092f\u091f\u0915 \u092e\u0941\u0916\u094d\u092f \u0915\u0947\u0902\u0926\u094d\u0930 \u092c\u093f\u0902\u0926\u0941 \u092e\u093e\u0928\u0924\u0947 \u0939\u0948\u0902\u0964", "audio_duration_s": 6.965986394557823, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.2381768921298435, "dnsmos_sig": 3.5787589455484685, "dnsmos_bak": 3.990125715123578}
{"id": "nat_hi_48", "language": "hi", "text": "\u0924\u0940\u0938\u0930\u0940 \u0936\u0924\u093e\u092c\u094d\u0926\u0940 \u0908\u0938\u093e \u092a\u0942\u0930\u094d\u0935 \u092e\u0947\u0902 \u092e\u093f\u0938\u094d\u0930\u093f\u092f\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u093f\u0930\u094d\u092e\u093f\u0924, \u0917\u094d\u0930\u0947\u091f \u092a\u093f\u0930\u093e\u092e\u093f\u0921 \u092e\u0943\u0924 \u092b\u093f\u0930\u094c\u0928 \u0915\u093e \u0938\u092e\u094d\u092e\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u093f\u0930\u094d\u092e\u093f\u0924 \u0915\u0908 \u092c\u0921\u093c\u0940 \u092a\u093f\u0930\u093e\u092e\u093f\u0921 \u0938\u0902\u0930\u091a\u0928\u093e\u0913\u0902 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u0939\u0948\u0964", "audio_duration_s": 9.287981859410431, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.361879169562496, "dnsmos_sig": 3.62722974612048, "dnsmos_bak": 4.1114554649613355}
{"id": "nat_hi_49", "language": "hi", "text": "\u091c\u0948\u0938\u0947-\u091c\u0948\u0938\u0947 \u0917\u094d\u0930\u0940\u0915 \u0915\u093e \u091c\u094d\u091e\u093e\u0928 \u0918\u091f\u0924\u093e \u0917\u092f\u093e, \u092a\u0936\u094d\u091a\u093f\u092e \u0928\u0947 \u0916\u0941\u0926 \u0915\u094b \u0905\u092a\u0928\u0940 \u0917\u094d\u0930\u0940\u0915 \u0926\u093e\u0930\u094d\u0936\u0928\u093f\u0915 \u0914\u0930 \u0935\u0948\u091c\u094d\u091e\u093e\u0928\u093f\u0915 \u091c\u0921\u093c\u094b\u0902 \u0938\u0947 \u0915\u091f\u093e \u0939\u0941\u0906 \u092a\u093e\u092f\u093e.", "audio_duration_s": 6.408707482993197, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.346008180231978, "dnsmos_sig": 3.639333991885439, "dnsmos_bak": 4.102137082847914}
