{"id": "nat_ko_0", "language": "ko", "text": "\ub2e4\ub9ac \ubc11 \uc218\uc9c1 \uac04\uaca9\uc740 15\ubbf8\ud130\uc774\uba70, \uacf5\uc0ac\ub294 2011\ub144 8\uc6d4\uc5d0 \ub9c8\ubb34\ub9ac\ub418\uc5c8\uc73c\uba70, \ud574\ub2f9 \ub2e4\ub9ac\uc758 \ud1b5\ud589\uae08\uc9c0\ub294 2017\ub144 3\uc6d4\uae4c\uc9c0\uc774\ub2e4.", "audio_duration_s": 8.6378231292517, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.2805054103924154, "dnsmos_sig": 3.607640504542041, "dnsmos_bak": 3.982818495453505}
{"id": "nat_ko_1", "language": "ko", "text": "\ub378 \ud3ec\ud2b8\ub85c\uac00 2\uc138\ud2b8\uc5d0\uc11c \uba3c\uc800 \uc5b4\ub4dc\ubc34\ud2f0\uc9c0\ub97c \uc5bb\uc5c8\uc9c0\ub9cc 6 \ub300 6\uc774 \ub41c \ud6c4 \ub2e4\uc2dc \ud0c0\uc774 \ube0c\ub808\uc774\ud06c\uac00 \ud544\uc694\ud588\ub2e4.", "audio_duration_s": 6.780226757369615, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4814488994700783, "dnsmos_sig": 3.706016779323668, "dnsmos_bak": 4.192826024951937}
{"id": "nat_ko_2", "language": "ko", "text": "\uc5fc\uc18c \uc0ac\uc721\uc740 \ub300\ub7b5 \uc77c\ub9cc \ub144 \uc804\uc5d0 \uc774\ub780\uc758 \uc790\uadf8\ub85c\uc2a4\uc0b0\ub9e5\uc5d0\uc11c \uc2dc\uc791\ud55c \uac83\uc73c\ub85c \ubcf4\uc785\ub2c8\ub2e4.", "audio_duration_s": 5.294149659863946, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.352575454266601, "dnsmos_sig": 3.6017521227590574, "dnsmos_bak": 4.10745368016904}
{"id": "nat_ko_3", "language": "ko", "text": "\uaca8\uc6b8\uc5d0 \ubd81\ubc1c\ud2b8\ud574\ub97c \uac74\ub110 \uacbd\uc6b0\uc5d0\ub294 \ube59\ud310\uc744 \ud1b5\uacfc\ud558\uba74\uc11c \uaf64 \ub054\ucc0d\ud55c \uc18c\uc74c\uc774 \ubc1c\uc0dd\ud558\uae30 \ub54c\ubb38\uc5d0, \uac1d\uc2e4\uc758 \uc704\uce58\ub97c \ud655\uc778\ud558\ub294 \uac83\uc774 \uc88b\ub2e4.", "audio_duration_s": 7.523265306122449, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.387078566471558, "dnsmos_sig": 3.6070666351999647, "dnsmos_bak": 4.142408029988355}
{"id": "nat_ko_4", "language": "ko", "text": "\ud64d\ucf69\uc758 \uc2a4\uce74\uc774\ub77c\uc778\uc744 \uc774\ub8e8\ub294 \ube4c\ub529 \ud589\ub82c\uc740 \ube45\ud1a0\ub9ac\uc544 \ud56d\uad6c\uc758 \uc218\uba74\uc5d0 \uc120\uba85\ud788 \ube44\uce58\ub294 \ubaa8\uc2b5 \ub54c\ubb38\uc5d0 \ubc18\uc9dd\uc774\ub294 \ub9c9\ub300\uadf8\ub798\ud504\uc5d0 \ube44\uc720\ub41c\ub2e4.", "audio_duration_s": 7.430385487528345, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4041450418874, "dnsmos_sig": 3.6704204768362914, "dnsmos_bak": 4.137296493464387}
{"id": "nat_ko_5", "language": "ko", "text": "\ud569\uae08\uc740 \uae30\ubcf8\uc801\uc73c\ub85c \uae08\uc18d \ub450 \uac1c \uc774\uc0c1\uc758 \ud63c\ud569\ubb3c\uc774\ub2e4. \uc8fc\uae30\uc728\ud45c \uc0c1\uc5d0 \uc6d0\uc18c\uac00 \ub9ce\uc774 \uc788\ub2e4\ub294 \uac83\uc744 \uc78a\uc9c0 \ub9c8\ub77c.", "audio_duration_s": 6.873106575963718, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3492998936255365, "dnsmos_sig": 3.596572810190613, "dnsmos_bak": 4.130377429412659}
{"id": "nat_ko_6", "language": "ko", "text": "\"1940\ub144 8\uc6d4 15\uc77c, \uc5f0\ud569\uad70\uc740 \ud504\ub791\uc2a4 \ub0a8\ubd80\ub97c \uce68\ub7b5\ud588\uace0, \uc774 \uce68\ub7b5\uc740 \"\"\ub4dc\ub798\uad70 \uc791\uc804\"\"\uc774\ub77c \ubd88\ub838\ub2e4. \"", "audio_duration_s": 6.6873469387755105, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3388960786329385, "dnsmos_sig": 3.586497349733732, "dnsmos_bak": 4.131787341479118}
{"id": "nat_ko_7", "language": "ko", "text": "\uadf8\ub798\ub3c4 \uad00\uacc4\uc790\uc758 \uc870\uc5b8\uc744 \ub4e3\uace0 \ubaa8\ub4e0 \ud45c\uc9c0\ud310\uc744 \uc9c0\ud0a4\uace0, \uc548\uc804 \uacbd\uace0\uc5d0 \uc138\uc2ec\ud55c \uc8fc\uc758\ub97c \uae30\uc6b8\uc5ec\uc57c \ud569\ub2c8\ub2e4.", "audio_duration_s": 6.780226757369615, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.354726501760314, "dnsmos_sig": 3.585460206990297, "dnsmos_bak": 4.143645524141336}
{"id": "nat_ko_8", "language": "ko", "text": "\uc9c0\ud558\ucca0\uc758 \uc815\uaddc \uc548\ub0b4 \ubc29\uc1a1\uc740 \uce74\ud0c8\ub85c\ub2c8\uc544\uc5b4\ub85c\ub9cc \uc81c\uacf5\ub418\ub098, \uacc4\ud68d\uc5d0 \uc5c6\ub358 \uc6b4\ud589 \uc911\ub2e8 \uc2dc\uc5d0\ub294 \uc790\ub3d9 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574 \uc2a4\ud398\uc778\uc5b4, \uc601\uc5b4, \ud504\ub791\uc2a4\uc5b4, \uc544\ub77c\ube44\uc544\uc5b4, \uc77c\ubcf8\uc5b4\ub97c \ud3ec\ud568\ud55c \ub2e4\uc591\ud55c \uc5b8\uc5b4\ub85c \ubc29\uc1a1\ub429\ub2c8\ub2e4.", "audio_duration_s": 11.981496598639456, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4873442493173243, "dnsmos_sig": 3.6772662839545287, "dnsmos_bak": 4.209839490864578}
{"id": "nat_ko_9", "language": "ko", "text": "\uad50\uc804\uc774 \ubc1c\ubc1c\ud55c \uc9c1\ud6c4 \uc601\uad6d\uc740 \ub3c5\uc77c\uc5d0 \ub300\ud55c \ud574\uc0c1 \ubd09\uc1c4\ub97c \uc2dc\uc791\ud55c\ub2e4.", "audio_duration_s": 4.365351473922902, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.447690269020535, "dnsmos_sig": 3.714966844681736, "dnsmos_bak": 4.172346162581531}
{"id": "nat_ko_10", "language": "ko", "text": "\uae30\uc9c0\uad6d\uc5d0 \uc774\uc911 \ub77c\ub514\uc624\uac00 \uc788\ub2e4\uba74 \uc774\uac83\uc774 802.11a, 802.11b\uc640 802.11g\uac00 \uc774\uc804 \uae30\uc885\uc774\ub77c\ub3c4 \ud638\ud658\ud560 \uc218 \uc788\uac8c \ud574\uc900\ub2e4.", "audio_duration_s": 7.894784580498866, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.2689899836624736, "dnsmos_sig": 3.6349868552084548, "dnsmos_bak": 3.9449397482538586}
{"id": "nat_ko_11", "language": "ko", "text": "\uaca8\uc6b0 2\uc8fc \ub9cc\uc5d0 \ubbf8\uad70\uacfc \uc790\uc720 \ud504\ub791\uc2a4\uad70\uc740 \ud504\ub791\uc2a4 \ub0a8\ubd80\ub97c \ud574\ubc29\uc2dc\ud0a4\uace0 \ub3c5\uc77c\ub85c \uc9c4\uaca9 \ubc29\ud5a5\uc744 \ud2c0\uace0 \uc788\uc5c8\ub2e4.", "audio_duration_s": 7.337505668934241, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.468039813925823, "dnsmos_sig": 3.6779453889412146, "dnsmos_bak": 4.1978806683049195}
{"id": "nat_ko_12", "language": "ko", "text": "\uc0ac\uac74 \ubc1c\uc0dd \uc774\ud6c4, \uae41\uc2a8(Gibson)\uc740 \ubcd1\uc6d0\uc73c\ub85c \uc774\uc1a1\ub418\uc5c8\uc73c\ub098 \uc5bc\ub9c8 \ud6c4 \uc228\uc744 \uac70\ub480\ub2e4.", "audio_duration_s": 4.365351473922902, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.310962711216981, "dnsmos_sig": 3.677954302875019, "dnsmos_bak": 3.967850881773322}
{"id": "nat_ko_13", "language": "ko", "text": "\"\uae30\uc220 \uacb0\uc815\ub860\uc5d0 \ub300\ud55c \ub300\ubd80\ubd84\uc758 \ud574\uc11d\uc740 \ub450 \uac00\uc9c0 \uac1c\ub150\uc744 \uac16\uc2b5\ub2c8\ub2e4. \uae30\uc220 \uac1c\ubc1c \uc790\uccb4\uac00 \ubb38\ud654\ub098 \uc815\uce58 \uc774\uc0c1\uc758 \uc601\ud5a5\ub825\uc744 \ubcf4\uc778\ub2e4\ub294 \uac83\uacfc \uae30\uc220\uc740 \uc0ac\ud68c\uc801\uc73c\ub85c \ud1b5\uc81c\ub418\ub294 \uac83\uc774 \uc544\ub2c8\ub77c \uc624\ud788\ub824 \uc0ac\ud68c\uc5d0 \ubcf8\uc9c8\uc801\uc778 \"\"\uc601\ud5a5\"\"\uc744 \ubbf8\uce69\ub2c8\ub2e4.\"", "audio_duration_s": 13.188934240362812, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.602921672529373, "dnsmos_sig": 3.8091944161423026, "dnsmos_bak": 4.218168629566053}
{"id": "nat_ko_14", "language": "ko", "text": "\ub300\uc11c\uc591 \ud5c8\ub9ac\ucf00\uc778\uc758 \uc5f4 \ubc88\uc9f8 \ud3ed\ud48d\uc778 \uc544\uc5f4\ub300 \ud3ed\ud48d \uc81c\ub9ac\uac00 \uc624\ub298 \ub300\uc11c\uc591\uc5d0\uc11c \uc0dd\uc131\ub418\uc5c8\uc2b5\ub2c8\ub2e4.", "audio_duration_s": 6.03718820861678, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.2587130430564337, "dnsmos_sig": 3.5795032071070345, "dnsmos_bak": 3.992252385007404}
{"id": "nat_ko_15", "language": "ko", "text": "\ubb34\uac70\uc6b4 \uc138\uae08\uc744 \ubb3c\ub9ac\ub294 \uad6d\uac00\uc758 \uc5ec\ud589\uac1d\ub4e4\uc740 \ub54c\ub54c\ub85c \uc0c1\ub2f9\ud55c \uae08\uc561\uc744 \uc544\ub084 \uc218 \uc788\ub2e4. \ud2b9\ud788 \uc8fc\ub958\ub098 \ub2f4\ubc30\ub97c \uc0b4 \ub54c \uadf8\ub807\ub2e4.", "audio_duration_s": 7.987664399092971, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.427794499008812, "dnsmos_sig": 3.6369848434627343, "dnsmos_bak": 4.180739244440832}
{"id": "nat_ko_16", "language": "ko", "text": "\ub110\ub9ac \uc54c\ub824\uc9c4 \uc0ac\ud30c\ub9ac\ub77c\ub294 \ud45c\ud604\uc740 \ud2b9\ud788 \uc0ac\ubc14\ub098\uc758 \uba4b\uc9c4 \uc544\ud504\ub9ac\uce74\uc758 \uc57c\uc0dd\ub3d9\ubb3c\ub4e4\uc744 \ubcf4\uae30\uc704\ud55c \uc721\ub85c \uc5ec\ud589\uc744 \uce6d\ud55c\ub2e4.", "audio_duration_s": 6.965986394557823, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.1908791015667095, "dnsmos_sig": 3.520756734213016, "dnsmos_bak": 3.964905632788901}
{"id": "nat_ko_17", "language": "ko", "text": "\ud64d\ucf69 \uc12c\uc740 \ud64d\ucf69 \uc601\ud1a0\uc5d0 \ud64d\ucf69\uc774\ub77c\ub294 \uc774\ub984\uc744 \ubd80\uc5ec\ud55c \uacf3\uc774\uc790 \ub9ce\uc740 \uad00\uad11\uac1d\ub4e4\uc774 \uc8fc\uc548\uc810\uc73c\ub85c \uc5ec\uae30\ub294 \uacf3\uc774\ub2e4.", "audio_duration_s": 6.501587301587302, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4251461440994566, "dnsmos_sig": 3.672938718738524, "dnsmos_bak": 4.16958537399403}
{"id": "nat_ko_18", "language": "ko", "text": "\uad50\uc804\uc774 \ubc1c\ubc1c\ud55c \uc9c1\ud6c4 \uc601\uad6d\uc740 \ub3c5\uc77c\uc5d0 \ub300\ud55c \ud574\uc0c1 \ubd09\uc1c4\ub97c \uc2dc\uc791\ud55c\ub2e4.", "audio_duration_s": 4.458231292517007, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3943227905371987, "dnsmos_sig": 3.638923529815034, "dnsmos_bak": 4.156037533651969}
{"id": "nat_ko_19", "language": "ko", "text": "\ub9cc\uc57d \ub0b4\uc154\ub110 \ud2b8\ub808\uc800\ub77c\ub294 \uc601\ud654\ub97c \ubd24\ub2e4\uba74, \uc544\ub9c8 \ub3c5\ub9bd\uc120\uc5b8\uc11c\uc758 \ub4b7\uba74\uc5d0 \ubcf4\ubb3c\uc9c0\ub3c4\uac00 \uc4f0\uc5ec\uc84c\ub2e4\uace0 \uc0dd\uac01\ud560\uc9c0\ub3c4 \ubaa8\ub978\ub2e4.", "audio_duration_s": 6.780226757369615, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.498628398807904, "dnsmos_sig": 3.706406904879002, "dnsmos_bak": 4.189561579063192}
{"id": "nat_ko_20", "language": "ko", "text": "\ubcf4\uace0\uc11c\ub294 \ud589\uc815\ubd80\uc758 \ud604\uc7ac \uc774\ub77c\ud06c \uc815\ucc45\uc5d0 \ub300\ud574 \uac70\uc758 \ubaa8\ub4e0 \uce21\uba74\uc5d0\uc11c \ub9e4\uc6b0 \ube44\ud310\uc801\uc774\uba70 \uc989\uac01\uc801\uc778 \ubc29\ud5a5 \ubcc0\uacbd\uc744 \ucd09\uad6c\ud569\ub2c8\ub2e4.", "audio_duration_s": 7.987664399092971, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4842192381205135, "dnsmos_sig": 3.7085640528070787, "dnsmos_bak": 4.174963645580767}
{"id": "nat_ko_21", "language": "ko", "text": "\uc655\uacfc \uc655\ube44\ub294 \ub9c8\ucc28\ub97c \ud0c0\uace0 \uc790\uc2e0\ub4e4\uc5d0\uac8c \uc18c\ub9ac\ub97c \uc9c0\ub974\uace0 \uc704\ud611\uc744 \ud558\ub294 \uad70\uc911\ub4e4\uc5d0\uac8c \ub458\ub7ec\uc2f8\uc778 \ucc44 \ud30c\ub9ac\ub85c \ub3cc\uc544\uac14\ub2e4.", "audio_duration_s": 6.780226757369615, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.356272011552876, "dnsmos_sig": 3.593849050821155, "dnsmos_bak": 4.113989699530208}
{"id": "nat_ko_22", "language": "ko", "text": "\uc77c\ubd80 \uc9c0\uc5ed\uc5d0\uc11c\ub294 1\ubd84\uac04 \ubb3c\uc744 \ub053\uc774\ub294 \uac83\uc73c\ub85c \ucda9\ubd84\ud558\ub2e4. \ub2e4\ub978 \uc9c0\uc5ed\uc5d0\uc11c\ub294 \uc218 \ubd84 \ub3d9\uc548 \ubb3c\uc744 \ub053\uc77c \ud544\uc694\uac00 \uc788\ub2e4.", "audio_duration_s": 7.801904761904762, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4585163226068674, "dnsmos_sig": 3.676227137224408, "dnsmos_bak": 4.1912007887832585}
{"id": "nat_ko_23", "language": "ko", "text": "1537\ub144 \uc544\uc21c\uc2dc\uc628(Asunci\u00f3n)\uc774 \uc124\ub9bd\ub41c \uc774\ub798 \ud30c\ub77c\uacfc\uc774\ub294 \ud1a0\ucc29\uc801\uc778 \ud2b9\uc9d5\uacfc \uc815\uccb4\uc131\uc744 \uc0c1\ub2f9 \ubd80\ubd84 \uc720\uc9c0\ud574 \uc654\uc2b5\ub2c8\ub2e4.", "audio_duration_s": 6.873106575963718, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.477166788639677, "dnsmos_sig": 3.6961060256615283, "dnsmos_bak": 4.207456918473712}
{"id": "nat_ko_24", "language": "ko", "text": "\uc624\ub298\ub0a0 \ub0a0\uac1c\ub97c \uc811\uc744 \uc218 \uc5c6\ub294 \uace4\ucda9\uc740 \uc7a0\uc790\ub9ac\uc640 \ud30c\ub9ac\ubc16\uc5d0 \uc5c6\uc2b5\ub2c8\ub2e4.", "audio_duration_s": 5.201269841269841, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.5232981351282846, "dnsmos_sig": 3.734948986695407, "dnsmos_bak": 4.215953252008309}
{"id": "nat_ko_25", "language": "ko", "text": "\ud569\uae08\uc740 \uae30\ubcf8\uc801\uc73c\ub85c \uae08\uc18d \ub450 \uac1c \uc774\uc0c1\uc758 \ud63c\ud569\ubb3c\uc774\ub2e4. \uc8fc\uae30\uc728\ud45c \uc0c1\uc5d0 \uc6d0\uc18c\uac00 \ub9ce\uc774 \uc788\ub2e4\ub294 \uac83\uc744 \uc78a\uc9c0 \ub9c8\ub77c.", "audio_duration_s": 7.151746031746032, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.526666109045382, "dnsmos_sig": 3.7240607767505827, "dnsmos_bak": 4.216048685158688}
{"id": "nat_ko_26", "language": "ko", "text": "\uc5f0\uc608 \ub274\uc2a4 \uc6f9\uc0ac\uc774\ud2b8\uc778 TMZ\ub294 \uc0ac\uc9c4\uc0ac\uac00 \uc138\ud480\ubca0\ub2e4 \ub300\ub85c \ub9de\uc740\ud3b8\uc5d0 \ucc28\ub97c \uc138\uc6cc \ub450\uace0, \uae38\uc744 \uac74\ub108\uae30 \uc804\uc5d0 \uacc4\uc18d\ud574\uc11c \uacbd\ucc30\uc11c \uc0ac\uc9c4\uc744 \ucc0d\uc73c\ub824 \uc2dc\ub3c4\ud558\uc600\uc73c\uba70, \uc774\uc5d0 \uad50\ud1b5\uc815\ub9ac\ub97c \ud558\ub358 \uce98\ub9ac\ud3ec\ub2c8\uc544 \uace0\uc18d\ub3c4\ub85c \uacbd\ucc30\uc774 \ub450 \ubc88\uc774\ub098 \ubb3c\ub7ec\ub098\ub3c4\ub85d \uba85\ub839\ud588\ub358 \uac83\uc5d0 \ub300\ud574 \uc2dc\uc778\ud558\uc600\uc2b5\ub2c8\ub2e4.", "audio_duration_s": 15.32517006802721, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3442461087391866, "dnsmos_sig": 3.6257921906746398, "dnsmos_bak": 4.072465887802481}
{"id": "nat_ko_27", "language": "ko", "text": "\uc0dd\uc2dd \uacc4\uc5f4 \uc138\ud3ec\uc758 \ub3cc\uc5f0\ubcc0\uc774\ub9cc\uc774 \uc790\ub140\uc5d0\uac8c \uc720\uc804\ub420 \uc218 \uc788\uace0, \ub2e4\ub978 \uacf3\uc5d0\uc11c\uc758 \ub3cc\uc5f0\ubcc0\uc774\ub294 \uc138\ud3ec \uc0ac\ub9dd \ub610\ub294 \uc554\uc744 \uc720\ubc1c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.", "audio_duration_s": 8.6378231292517, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.257547149662183, "dnsmos_sig": 3.6407917687719507, "dnsmos_bak": 3.902269152195438}
{"id": "nat_ko_28", "language": "ko", "text": "\ud6c8\ub294 \uc0ac\uc784\ud588\uace0 \ub0b4\uac01\uc5d0\uc11c \uc5d0\ub4dc \ub370\uc774\ube44 \ud558\uc6d0 \uc758\uc6d0\uc5d0 \uc758\ud574 \uad50\uccb4\ub420 \uc608\uc815\uc774\ub2e4. \ub178\uba3c \ub7a8 \ud558\uc6d0 \uc758\uc6d0\uc740 \ub370\uc774\ube44\uac00 \ub5a0\ub098\ub294 \uc0ac\uc5c5\ubd80 \uc7a5\uad00\uc9c1\uc744 \ubc2d\uc744 \uac83\uc73c\ub85c \uc608\uc0b0\ub41c\ub2e4.", "audio_duration_s": 10.031020408163265, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.42981577585874, "dnsmos_sig": 3.6266996476792603, "dnsmos_bak": 4.1980996765576}
{"id": "nat_ko_29", "language": "ko", "text": "\ube44\ub85d \uc911\uc559 \ubb34\ub300\uc5d0\uc11c \uc5f0\uc8fc\ud558\ub294 \uace1\uc740 \ub05d\ub0a0 \uc218 \uc788\uc9c0\ub9cc, \ucd95\uc81c \uacf3\uacf3\uc5d0\uc11c\ub294 \ubc24\ub2a6\uac8c\uae4c\uc9c0 \uc74c\uc545\uc744 \uc5f0\uc8fc\ud560 \uc218\ub3c4 \uc788\ub2e4\ub294 \uac83\uc744 \uc78a\uc9c0 \ub9c8\uc138\uc694.", "audio_duration_s": 8.080544217687075, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.5148024432072007, "dnsmos_sig": 3.725037706047114, "dnsmos_bak": 4.198699020896053}
{"id": "nat_ko_30", "language": "ko", "text": "\ud638\uc8fc\uc758 \ubbf8\uccbc \uace8\ub9ac\ub294 \ub0a8\uc790 \uc2a4\ud0e0\ub529 \uc288\ud37c-G\uc5d0\uc11c 11\uc704\ub97c \ucc28\uc9c0\ud588\uc2b5\ub2c8\ub2e4. \uccb4\ucf54 \ucd9c\uc2e0\uc758 \uacbd\uc7c1\uc790, \uc62c\ub4dc\ub9ac\uce58 \uc824\ub9ac\ub125\uc740 \ub0a8\uc790 \uc88c\uc2dd \uc288\ud37c-G\uc5d0\uc11c 16\uc704\ub85c \uacbd\uae30\ub97c \ub9c8\ucce4\uc2b5\ub2c8\ub2e4.", "audio_duration_s": 9.659501133786849, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3762359220686, "dnsmos_sig": 3.6087706380374582, "dnsmos_bak": 4.158933375348036}
{"id": "nat_ko_31", "language": "ko", "text": "\ud30c\ub9ac \uc0ac\ub78c\ub4e4\uc740 \uc790\uae30\uc911\uc2ec\uc801\uc774\uace0, \ubb34\ub840\ud558\uace0, \uc624\ub9cc\ud558\ub2e4\ub294 \ud3c9\ud310\uc774 \uc788\uc2b5\ub2c8\ub2e4.", "audio_duration_s": 4.551111111111111, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.3399617319376933, "dnsmos_sig": 3.650090062168092, "dnsmos_bak": 4.0466428736651405}
{"id": "nat_ko_32", "language": "ko", "text": "\ucee4\ub9ac\ub294 \uc57d\uc6a9 \uc2dd\ubb3c\uacfc \ud5a5\uc2e0\ub8cc\ub97c \uae30\ubcf8\uc73c\ub85c \ud558\uc5ec \uace0\uae30\ub098 \ucc44\uc18c\ub97c \uacc1\ub4e4\uc774\ub294 \uc694\ub9ac\uc785\ub2c8\ub2e4.", "audio_duration_s": 5.6656689342403626, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.306212545129022, "dnsmos_sig": 3.6283796910935195, "dnsmos_bak": 3.993069779841004}
{"id": "nat_ko_33", "language": "ko", "text": "\uc544\uc774\ud2f0 \uc815\uc758\uc640 \ubbfc\uc8fc\uc8fc\uc758 \uc5f0\uad6c\uc18c\ub294 \ub124\ud314\uc758 UN \ud3c9\ud654 \uc720\uc9c0 \ubd80\ub300\uac00 \uc758\ub3c4\uce58 \uc54a\uac8c \uc544\uc774\ud2f0\uc5d0 \uc9c8\ubcd1\uc744 \uc804\ud30c\uc2dc\ucf30\ub2e4\ub294 \ub3c5\ub9bd\uc801\uc778 \uc5f0\uad6c\ub97c \uc5b8\uae09\ud588\ub2e4.", "audio_duration_s": 8.916462585034013, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4601765544300096, "dnsmos_sig": 3.681107916369213, "dnsmos_bak": 4.182036830693929}
{"id": "nat_ko_34", "language": "ko", "text": "\uace0\ud1b5\uc744 \uadf9\ubcf5\ud558\ub294 \ub370 \ud544\uc694\ud55c \uc57d\ub4e4\uc774 \uacbd\uae30\uc5d0\uc11c\ub294 \uae08\uc9c0\ub41c \uc57d\ubb3c\uc774\uae30\uc5d0 \ubcf5\uc6a9\uc744 \ud560 \uc218 \uc5c6\uc5c8\ub2e4.", "audio_duration_s": 5.758548752834467, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.28904494486612, "dnsmos_sig": 3.595518524468191, "dnsmos_bak": 4.025435207850355}
{"id": "nat_ko_35", "language": "ko", "text": "\uc790\uc2e0\uc758 \uc758\uacac\uc774 \uc544\ub2cc \uc815\ubd80\uc758 \uc758\uacac\uc744 \ub4e3\uace0 \uc2f6\uc744 \uc218\ub3c4 \uc788\uc9c0\ub9cc, \uac01\uad6d \uc815\ubd80\uc758 \uc870\uc5b8\ub4e4\uc740 \uc790\uad6d\ubbfc\uc5d0 \ub9de\ucdb0\uc838 \uc788\ub2e4.", "audio_duration_s": 6.6873469387755105, "utmos": null, "utmos_note": "UTMOS validated on English only (zh OOD); not a valid naturalness score for this language.", "dnsmos_ovrl": 3.4036084890089846, "dnsmos_sig": 3.6380340331701135, "dnsmos_bak": 4.1643910226089975}
