{"id": "prosody_hi_4", "language": "hi", "text": "\u0907\u0902\u091f\u0930\u0928\u0947\u091f \u092a\u0930 \u092f\u0939 \u0916\u094b\u091c '\u0936\u0924\u094d\u0930\u0941\u0924\u093e\u092a\u0942\u0930\u094d\u0923 \u092a\u0930\u094d\u092f\u093e\u0935\u0930\u0923 \u092a\u093e\u0920\u094d\u092f\u0915\u094d\u0930\u092e' \u0915\u0947 \u0932\u093f\u090f \u0905\u0915\u094d\u0938\u0930 \u0906\u092a\u0915\u094b \u090f\u0915 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0915\u0902\u092a\u0928\u0940 \u0915\u093e \u092a\u0924\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0917\u0940\u0964", "wpm": 143.6, "f0_mean_hz": 184.6, "f0_std_intra_hz": 22.4, "f0_range_intra_hz": 71.3, "npvi": 63.5, "pause_ratio": 0.009}
