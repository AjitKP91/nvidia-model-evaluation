{"id": "prosody_hi_8", "language": "hi", "text": "\u0938\u092c\u0938\u0947 \u0928\u091c\u093c\u0926\u0940\u0915\u0940 \u0938\u093f\u0930\u0947 \u092a\u0930 \u0915\u094d\u0930\u0938\u094d\u091f \u0915\u0940 \u092e\u094b\u091f\u093e\u0908 \u0915\u0930\u0940\u092c 70 \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930 \u0939\u0948 \u0914\u0930 \u0938\u092c\u0938\u0947 \u0926\u0942\u0930 \u0915\u0947 \u0938\u093f\u0930\u0947 \u092a\u0930 \u092f\u0939 100 \u0915\u093f\u0932\u094b\u092e\u0940\u091f\u0930 \u0939\u0948.", "wpm": 183.3, "f0_mean_hz": 184.1, "f0_std_intra_hz": 31.1, "f0_range_intra_hz": 95.3, "npvi": 64.2, "pause_ratio": 0.0}
{"id": "prosody_hi_9", "language": "hi", "text": "\u092f\u0939 \u0938\u0902\u092c\u0902\u0927\u093f\u0924 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0906\u092e \u0924\u094c\u0930 \u092a\u0930 \u0907\u0938\u092e\u0947\u0902 \u0905\u0932\u094d\u092a\u093e\u0907\u0928 \u0936\u0948\u0932\u0940 \u0915\u0940 \u0938\u094d\u0915\u0940 \u091f\u0942\u0930\u093f\u0902\u0917 \u092f\u093e \u092e\u093e\u0909\u0902\u091f\u0947\u0928\u0940\u092f\u0930\u093f\u0902\u0917 \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940 \u0939\u0948, \u091c\u093f\u0938\u0947 \u0916\u0921\u093c\u0947 \u0907\u0932\u093e\u0915\u094b\u0902 \u092e\u0947\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u091c\u093f\u0938\u0915\u0947 \u0932\u093f\u090f \u092c\u0939\u0941\u0924 \u0915\u0921\u093c\u0940 \u0938\u094d\u0915\u0940 \u0914\u0930 \u092c\u0942\u091f \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0939\u094b\u0924\u0940 \u0939\u0948.", "wpm": 201.2, "f0_mean_hz": 208.4, "f0_std_intra_hz": 38.8, "f0_range_intra_hz": 120.7, "npvi": 76.9, "pause_ratio": 0.0}
{"id": "prosody_hi_10", "language": "hi", "text": "\u092a\u0941\u0930\u0941\u0937\u094b\u0902 \u0915\u0947 \u0938\u094d\u091f\u0948\u0902\u0921\u093f\u0902\u0917 \u0938\u0941\u092a\u0930-\u091c\u0940 \u092e\u0947\u0902 \u0911\u0938\u094d\u091f\u094d\u0930\u0947\u0932\u093f\u092f\u093e \u0915\u0947 \u092e\u093f\u0936\u0947\u0932 \u0917\u094c\u0930\u0932\u0947 \u0917\u094d\u092f\u093e\u0930\u0939\u0935\u0947\u0902 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0939\u0947. \u091a\u0947\u0915 \u092a\u094d\u0930\u0924\u093f\u092f\u094b\u0917\u0940 \u0913\u0932\u094d\u0921\u0930\u093f\u091a \u091c\u0947\u0932\u093f\u0928\u0947\u0915 \u092a\u0941\u0930\u0941\u0937\u094b\u0902 \u0915\u0947 \u0938\u093f\u091f\u093f\u0902\u0917 \u0938\u0941\u092a\u0930-\u091c\u0940 \u092e\u0947\u0902 \u0938\u094b\u0932\u0939\u0935\u0947\u0902 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u0939\u0947.", "wpm": 160.0, "f0_mean_hz": 201.8, "f0_std_intra_hz": 32.9, "f0_range_intra_hz": 104.7, "npvi": 74.5, "pause_ratio": 0.007}
{"id": "prosody_hi_11", "language": "hi", "text": "\u0915\u0947\u0935\u0932 \u0926\u094b \u0939\u092b\u093c\u094d\u0924\u094b\u0902 \u092e\u0947\u0902 \u0905\u092e\u0947\u0930\u093f\u0915\u093f\u092f\u094b\u0902 \u0914\u0930 \u092b\u093c\u094d\u0930\u0940 \u092b\u093c\u094d\u0930\u0947\u0902\u091a \u092c\u0932\u094b\u0902 \u0928\u0947 \u0926\u0915\u094d\u0937\u093f\u0923\u0940 \u092b\u093c\u094d\u0930\u093e\u0902\u0938 \u0915\u094b \u092e\u0941\u0915\u094d\u0924 \u0915\u0930 \u0926\u093f\u092f\u093e \u0925\u093e \u0914\u0930 \u091c\u0930\u094d\u092e\u0928\u0940 \u0915\u0940 \u0913\u0930 \u092c\u0922\u093c \u0930\u0939\u0947 \u0925\u0947.", "wpm": 198.8, "f0_mean_hz": 206.1, "f0_std_intra_hz": 34.8, "f0_range_intra_hz": 109.0, "npvi": 62.2, "pause_ratio": 0.013}
